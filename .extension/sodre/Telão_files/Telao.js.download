        // metodos de carregamento
        carregarMedidasTela: function() {
            try {
                var objTelao = this;
                objTelao.setMedidaWidth($(window).width());
                objTelao.setMedidaHeight($(window).height());
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        carregarNavegador: function() {
            try {
                var objTelao = this;

                // Opera 8.0+
                var isOpera = (!!window.opr && !!opr.addons) || !!window.opera || navigator.userAgent.indexOf(' OPR/') >= 0;
                // Firefox 1.0+
                var isFirefox = typeof InstallTrigger !== 'undefined';
                // At least Safari 3+: "[object HTMLElementConstructor]"
                var isSafari = Object.prototype.toString.call(window.HTMLElement).indexOf('Constructor') > 0;
                // Internet Explorer 6-11
                var isIE = /*@cc_on!@*/false || !!document.documentMode;
                // Edge 20+
                var isEdge = !isIE && !!window.StyleMedia;
                // Chrome 1+
                var isChrome = !!window.chrome && !!window.chrome.webstore;
                // Blink engine detection
                var isBlink = (isChrome || isOpera) && !!window.CSS;

                if (isOpera) { objTelao.setNavegadorNome('opera'); }
                else if (isFirefox) { objTelao.setNavegadorNome('firefox'); }
                else if (isSafari) { objTelao.setNavegadorNome('safari'); }
                else if (isIE) { objTelao.setNavegadorNome('ie'); }
                else if (isEdge) { objTelao.setNavegadorNome('edge'); }
                else if (isChrome) { objTelao.setNavegadorNome('chrome'); }
                else if (isBlink) { objTelao.setNavegadorNome('blink'); }

                // objTelao.setNavegadorNome('chrome');
                // objTelao.setNavegadorVersao('1.0');
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        verificaMoeda: function () {
            var objTelao = this;

            // simbolo da moeda
            var leilao_id = this.getLeilaoId();
            var leiloes_dolar = objTelao.getLeiloesDolar();
            var verifica_leilao_id = $.inArray(leilao_id, leiloes_dolar);

            if (verifica_leilao_id >= 0) {
                objTelao.setSimboloMoeda('US$');
            }

        },
        carregarDadosLeilao: function() {
            try {
                var objTelao = this;

                // dom do leilao
                var $dados_leilao = objTelao.getPingRetorno().find('sslonline_leilao leilao');

                // condicoes de vendas
                var condicao_aceita = parseInt($dados_leilao.attr('condicao_aceita'));
                objTelao.setCondicoesVendaAceita(condicao_aceita);

                // usuarios online
                objTelao.setQuantidadeUsuariosOnline($dados_leilao.attr('qtde_usuarios'));

                // nome do leilao                
                var leilao_nome = [];
                var nm_leilao = $dados_leilao.attr('nm_leilao');
                var nm_leilao2 = $dados_leilao.attr('nm_leilao2');
                                
                var f_dt_leilao = (objTelao.leilao.leilao_id != 23281) ? $dados_leilao.attr('f_dt_leilao') : '22/11/2022';
                var horario_leilao = (objTelao.leilao.leilao_id != 23281) ? $dados_leilao.attr('horario_leilao') : '10:00h';
                
                var leilao_id = (objTelao.leilao.leilao_id != 23281) ? objTelao.getLeilaoId() : 23120;
                
                leilao_nome.push(leilao_id);
                if (nm_leilao2 != '') { leilao_nome.push(nm_leilao2); }
                if (nm_leilao != '') { leilao_nome.push(nm_leilao); }
                leilao_nome.push(f_dt_leilao + ' ' + horario_leilao);
                // /**/leilao_nome.push('(Usu&aacute;rios Online: ' + objTelao.getQuantidadeUsuariosOnline() + ')');
                objTelao.setLeilaoNome(leilao_nome.join(' - '));

                // data do leilao (para controle do video)
                objTelao.setDataHoraInicio($dados_leilao.attr('data_hora_inicio'));
                objTelao.setDataHoraAtual($dados_leilao.attr('data_hora_atual'));
                objTelao.setDataHoraAntes($dados_leilao.attr('data_hora_antes'));
                objTelao.setDataHoraDurante($dados_leilao.attr('data_hora_durante'));
                objTelao.setDataHoraDepois($dados_leilao.attr('data_hora_depois'));

                objTelao.setEncerrado($dados_leilao.attr('encerrado'));


                // tempo de ping
                // if (objTelao.getNavegadorFoco()) {
                //     var timer_refresh = $dados_leilao.attr('timer_refresh');
                //     objTelao.setPingTempo(timer_refresh);
                //     objTelao.setPingTempoFocus(timer_refresh);
                // } else {
                //     var timer_refresh = $dados_leilao.attr('timer_refresh');
                //     var timer_blur = objTelao.getPingTempoBlur();
                //     timer_blur = (timer_blur > timer_refresh) ? timer_blur : timer_refresh;
                //     objTelao.setPingTempo(timer_refresh);
                //     objTelao.setPingTempoBlur(timer_refresh);
                // }

                objTelao.carregarListaLotes();
                objTelao.carregarLotesAbertos();
                objTelao.carregarRepasses();
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        carregarListaLotes: function() {
            try {
                var objTelao = this;

                objTelao.limpaListaLotes([]);
                var $lista_lotes = objTelao.getPingRetorno().find('lote_list');

                $lista_lotes.find('item').each(function() {
                    var $item = $(this);
                    var lote_id = $item.attr('lote_id');
                    var nu_lote = $item.attr('nu_lote');

                    objTelao.pushListaLotes({
                        lote_id: lote_id,
                        nu_lote: nu_lote
                    });
                });

                // lotes prox e ant
                var $lote = objTelao.getPingRetorno().find('sslo_status lote');
                objTelao.setLeilaoLoteIdAnterior($lote.attr('ant_lote_id'));
                objTelao.setLeilaoLoteIdProximo($lote.attr('prox_lote_id'));
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        carregarDadosLote: function() {
            try {
                var objTelao = this;

                var $dados_lote_atual = objTelao.getPingRetorno().find('sslo_status lote');

                var lote_atual_tempo_final = [];
                tempo_final = $.trim($dados_lote_atual.attr('tempo_restante_r'));
                tempo_final_split = tempo_final.split('_');
                lote_atual_tempo_final[0] = [];
                lote_atual_tempo_final[0].push(tempo_final_split[0]);
                lote_atual_tempo_final[0].push(tempo_final_split[1]);
                lote_atual_tempo_final[0].push(tempo_final_split[2]);
                lote_atual_tempo_final[0] = lote_atual_tempo_final[0].join('-');
                lote_atual_tempo_final[1] = [];
                lote_atual_tempo_final[1].push(tempo_final_split[3]);
                lote_atual_tempo_final[1].push(tempo_final_split[4]);
                lote_atual_tempo_final[1].push(tempo_final_split[5]);
                lote_atual_tempo_final[1] = lote_atual_tempo_final[1].join(':');
                objTelao.setLoteAtualTempoFinal(lote_atual_tempo_final.join(' '));

                objTelao.setLoteAtualNumero($dados_lote_atual.attr('nu_lote'));
                objTelao.setLoteAtualNome($dados_lote_atual.attr('descricao'));
                objTelao.setLoteAtualStatus($dados_lote_atual.attr('st_lote'));
                objTelao.setLoteAtualDescricao($.trim($dados_lote_atual.attr('desc_lote')));
                objTelao.setLoteAtualIncremento($.trim($dados_lote_atual.attr('incremento_minimo')));
                objTelao.setLoteAtualTermino($.trim($dados_lote_atual.attr('ter')));
                objTelao.setLoteAtualTj($.trim($dados_lote_atual.attr('tj')));
                objTelao.setLoteAtualMensagem($.trim($dados_lote_atual.attr('mensagem')));
                objTelao.setLoteAtualLanceAutomatico($.trim($dados_lote_atual.attr('vl_automatico')));
                objTelao.setLoteAtualLanceAutomaticoId($.trim($dados_lote_atual.attr('lanceauto_id')));

                objTelao.setLoteTpUnidade($dados_lote_atual.attr('tp_unidade'));
                objTelao.setLoteFotos360($dados_lote_atual.attr('fotos360'));
                objTelao.setLoteNmVistoria($dados_lote_atual.attr('nm_vistoria'));
                objTelao.setLoteNmInfoTaxa($dados_lote_atual.attr('nm_info_taxa'));

                //seta se um imovel esta desocupado e o tipo do segmento
                objTelao.setImovelDesocupado($.trim($dados_lote_atual.attr('bn_desocupado')) ==  1 ? $.trim($dados_lote_atual.attr('bn_desocupado')) : 0);
                objTelao.setTipoSegmento($.trim($dados_lote_atual.attr('tipo_segmento')).toLowerCase());

                //seta lotes al
                objTelao.setLoteAl($dados_lote_atual.attr('is_al'));
                
                // todos os lances e lances do usuario
                objTelao.carregarLances();
                objTelao.carregarBotoesLance();
                objTelao.carregarFotos();
                objTelao.carregarVideo();
                
                objTelao.setObjectInsider(objTelao.getPingRetorno().find('sslo_status'));
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        carregarLances: function() {
            try {
                var objTelao = this;

                /* TODOS OS LANCES */

                // pego a lista de lances
                var $lista_lances = objTelao.getPingRetorno().find('lance_list');
                objTelao.limpaLoteAtualLancesUsuario();
                objTelao.limpaLoteAtualLances();

                // percorro todos os lances
                $lista_lances.find('item').each(function() {
                    var $lance = $(this);
                    var usuario_id_lance = objTelao.formataNumero($lance.attr('user_id'));

                    // guardo os lances que o usuario deu
                    if (usuario_id_lance == objTelao.getUserId()) {
                        objTelao.pushLoteAtualLancesUsuario({
                            lance_id: $lance.attr('sslonline_lance_id'),
                            valor: $lance.attr('f_lance')
                        });
                    }

                    // e guardo todos os lances no objeto
                    // var nome = $.trim($lance.attr('nm_comprador'));
                    var apelido = $.trim($lance.attr('apelido'));
                    var cidade = $.trim($lance.attr('cidade'));
                    var uf = $.trim($lance.attr('uf'));

                    // if (apelido != '') {
                    //     nome = apelido;
                    // }

                    // nome_usuario = objTelao.formataNome(nome);
                    nome_usuario = objTelao.formataNome(apelido, cidade, uf);
                    // nome_usuario = nome;

                    objTelao.pushLoteAtualLances({
                        lance_id: $lance.attr('sslonline_lance_id'),
                        user_id: $lance.attr('user_id'),
                        valor: $lance.attr('f_lance'),
                        valor_desconto: $lance.attr('f_lance_desconto'),
                        usuario: nome_usuario,
                        numero: $lance.attr('nu'),
                        cidade: $lance.attr('cidade'),
                        uf: $lance.attr('uf'),
                        taxa: $lance.attr('taxa'),
                        total: $lance.attr('total'),
                        total_desconto: $lance.attr('total_desconto')
                    });
                });

                /* ULTIMO LANCE */

                // pego o ultimo lance da listagem (o primeiro item do array)
                var $lance_atual = $lista_lances.find('item:first-child');
                var $dados_lote_atual = objTelao.getPingRetorno().find('sslo_status').find('lote');

                var obj_lance_atual = {
                    user_id: 0,
                    lance_id: 0,
                    valor: 0,
                    valor_desconto: 0,
                    usuario: '',
                    usuario_vencendo: 0
                };

                // se teve lances, guardo o primeiro lance no lance_atual
                if ($lance_atual.length == 1) {
                    // var nome = $.trim($lance_atual.attr('nm_comprador'));
                    var apelido = $.trim($lance_atual.attr('apelido'));
                    var cidade = $.trim($lance_atual.attr('cidade'));
                    var uf = $.trim($lance_atual.attr('uf'));

                    // if (apelido != '') {
                    //     nome = apelido;
                    // }

                    // nome_usuario = objTelao.formataNome(nome);
                    nome_usuario = objTelao.formataNome(apelido, cidade, uf);

                    obj_lance_atual.lance_id = $lance_atual.attr('sslonline_lance_id');
                    obj_lance_atual.valor = $lance_atual.attr('f_lance');
                    obj_lance_atual.valor_desconto = $lance_atual.attr('f_lance_desconto');
                    obj_lance_atual.usuario = nome_usuario;
                    obj_lance_atual.user_id = parseInt($lance_atual.attr('user_id'));

                    if (obj_lance_atual.user_id == objTelao.getUserId()) {
                        obj_lance_atual.usuario_vencendo = 1;
                    }
                } else {
                    // senao eu pego o lance inicial e coloco no lance_atual
                    var vl_lanceinicial = parseFloat($dados_lote_atual.attr('vl_lanceinicial'));
                    obj_lance_atual.valor = number_format(vl_lanceinicial, 0, ',', '.');
                }

                objTelao.setLoteAtualLanceAtual(obj_lance_atual);
                
                //mensagem valor minimo não estipulado                                             
                objTelao.setLanceMenorQueOMinimo(objTelao.getPingRetorno().find('msg_indicativo').attr('value'));
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        carregarBotoesLance: function() {
            try {
                var objTelao = this;

                objTelao.limpaBotoesLance([]);
                var $botoes_lances = objTelao.getPingRetorno().find('botoes_atalho').find('botoes');
                $botoes_lances.each(function() {
                    var $botao = $(this);
                    objTelao.pushBotoesLance({
                        vl_sugerido_real: $botao.attr('vl_sugerido_real'),
                        vl_sugerido: $botao.attr('vl_sugerido'),
                        vl_status: $botao.attr('vl_status')
                    });
                });
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        carregarLotesAbertos: function() {
            try {
                var objTelao = this;

                objTelao.limpaLotesAbertos([]);
                var $lotes_abertos = objTelao.getPingRetorno().find('loteaberto_list lote');
                $lotes_abertos.each(function() {
                    var $lote = $(this);
                    objTelao.pushLotesAbertos({
                        lote_id: $lote.attr('lote_id'),

var timeout_count_down = null;
var countdownLote = function($el, callback) {
    clearTimeout(timeout_count_down);

    var active = $el.attr('data-active');
    var stop = false;
    var jump = false;
    var old_value = null;

    // ativar apenas uma vez
    if (typeof active == 'undefined') {
        $el.attr('data-active', 1);
    } else {
        var value = $el.attr('data-countdown').trim();
        if (value == '') {
            jump = true;
        } else {
            old_value = value;
        }

        if (value.indexOf('ncerrado') != -1) {
            stop = true;
        } else if (value.indexOf('omologando') != -1 || value == '') {
            stop = true;
        } else if (value.indexOf('dia') == -1 && !jump) {
            if (value != '00:00:00') {
                value = value.split(':').map(function(i) {
                    return parseInt(i);
                });

                value[2]--;
                if (value[2] < 0) {
                    value[2] = 59;
                    value[1]--;

                    if (value[1] < 0) {
                        value[1] = 59;
                        value[0]--;
                    }
                }

                value = value.map(function(i) {
                    return (i <= 9) ? '0' + i : i;
                }).join(':');

                $el.attr('data-countdown', value);
            }
        }

        if (typeof callback == 'undefined') {
            $el.text(value);
        } else if (typeof callback == 'function') {
            callback(value, old_value);
        }
    }

    if (!stop) {
        timeout_count_down = setTimeout(function() {
            countdownLote($el, callback);
        }, 1000);
    }
};

var insiderEventDispatch = function(objTelao, vl_lance, automatico=false) {
    try {        
        window.insider_object = window.insider_object || {};
        window.insider_object.user = {
            gdpr_optin: true,
            email_optin: true,
            email: objTelao.getPingRetorno().find('usuario').attr('email')
        }
        Insider.eventManager.dispatch('init-manager:re-initialize');
        
        var type =  !automatico ? 'unitario' : 'automatico';
        var customEventParams = objTelao.getObjectInsider().veiculos;
        let segmento = 'veiculos';
        if (objTelao.getTipoSegmento().toLowerCase() == 'm') {            
            customEventParams = objTelao.getObjectInsider().materiais;
            segmento = 'materiais';
        } else if (objTelao.getTipoSegmento().toLowerCase() == 'i') {            
            customEventParams = objTelao.getObjectInsider().imoveis;
            segmento = 'imoveis';
        }
        var eventTrack = new EventTrackInsider(customEventParams, vl_lance);
        eventTrack.segment = segmento;
        eventTrack.type = type;
        eventTrack.reference = 'auditorio_virtual';
        eventTrack.lotId = '',
        eventTrack.auctionId = objTelao.leilao.leilao_id;
        eventTrack.lotId = objTelao.getLoteIdAtual();
        eventTrack.dispatchEvent();       
    } catch (error) {
        console.log('erro ao disparar evento para insider', error);
    }
};

(function($) {
    $.fn.countdown = function(callback) {
        this.each(function() {
            countdownLote($(this), callback);
        });
    };
})(jQuery);


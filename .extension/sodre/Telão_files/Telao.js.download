                    var html = '';
                    html += '<table class="table" style="margin-bottom: 0;">';
					html += '	<thead>';
					html += '		<tr>';
					html += '          <th style="vertical-align: top; padding-top: 0; padding-bottom: 0;" width="30%">Valor do Lance ' + textoDesconto + '</th>'
                    // if (!objTelao.leilao.nome.toLowerCase().includes("luxo".toLowerCase())) {

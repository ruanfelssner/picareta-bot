                            html +=           			objTelao.getLoteNmInfoTaxa()
                            html += '          		</div>'
                            html += '          	</div>'
                        }
                        html += '          </th>'
                    // }
					html += '          <th style="vertical-align: top; padding-top: 0; padding-bottom: 0;" width="30%">'                    
					html +=                cabecalhoTotal
                    if (objTelao.getLoteStInfoTotal()) {
                        html += '          <div class="icon-info">'
                        html += '          	   <span>i</span>'
                        html += '          	   <div class="taxa-desc">'
                        html +=           	   	   objTelao.getLoteNmInfoTotal()
                        html += '          	   </div>'
                        html += '          </div>'
                    }
					html += '          </th>'
					html += '		</tr>';
					html += '	</thead>';                    
					html += '	</table>';                    
					html += '	<div style="overflow: hidden; max-height: 180px;">';                    
					html += '	<table class="table">';   
                    html += '   <tbody>';
                    for (var i = 0; i < objTelao.getLoteAtualLances().length; i++) {
                        var lance = objTelao.getLoteAtualLances()[i];
                        if (objTelao.getLeiloesBlackFriday().includes(objTelao.leilao.leilao_id)) {
                            lance.valor = lance.valor_desconto
                            lance.total = lance.total_desconto
                        }
                        html += '       <tr style="border: 1px 1px 0 1px solid #ccc;">';
                        html += '       	<td colspan="3" style="padding-bottom: 0;"><b>' + lance.numero + ' - ' + lance.usuario + '</b></td>';
                        html += '       </tr>';
                        html += '       <tr>';
                        html += '       	<td style="border-top: none; padding-top: 0; color: #008eae;" width="30%">';
                        html += '       		<b>R$ ' + lance.valor + '</b>';
                        html += '       	</td>';
                        // if (!objTelao.leilao.nome.toLowerCase().includes("luxo".toLowerCase())) {
                            html += '       	<td style="border-top: none; padding-top: 0;" width="39%"> R$ ' + lance.taxa + '</td>';
                        // }
                        // html += '       	<td style="border-top: none; padding-top: 0;" width="30%"><b>R$ ' + (!objTelao.leilao.nome.toLowerCase().includes("luxo".toLowerCase()) ? lance.total : lance.valor) + '</b></td>';
                        html += '       	<td style="border-top: none; padding-top: 0;" width="30%"><b>R$ ' + lance.total + '</b></td>';
                        html += '       </tr>';
                        html += '       </tr>';
                    }
                    html += '   </tbody>';
                    html += '</table>';
                    html += '</div>';
                // }

                var $el = $(html);

                $('.act-lista-lances .panel-body').html($el);
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirLanceAtual: function() {
            try {
                var objTelao = this;

                var simbolo_moeda = objTelao.getSimboloMoeda();
                
                // coloco o valor do lance atual (ou minimo)
                $('.act-valor-lance-atual').html(simbolo_moeda + ' ' + objTelao.getLoteAtualLanceAtual().valor + objTelao.exibeMsgPorQuilo());                
                $('.act-valor-com-desconto').html('')
                if (objTelao.getLeiloesBlackFriday().includes(objTelao.getLeilaoId()) && objTelao.getLoteAtualLances().length > 0) {                    
                    $('.act-valor-com-desconto').html('com desconto de 5% <span class="valor-com-desconto"> R$ ' + objTelao.getLoteAtualLanceAtual().valor_desconto + '</span>')
                    .css({'text-align': 'center'});
                } 

                $('.act-mensagem_vl_minimo').html('');
                if (objTelao.getLanceMenorQueOMinimo() == 1) {
                    $('.act-mensagem_vl_minimo')
                    .css({'text-align':'center'})
                    .html('O valor m&iacute;nimo de venda estipulado ainda n&atilde;o foi atingido.');
                }
                
                
                // se nao tiver um lance, coloca a mensagem padrao
                $('.act-usuario-vencendo').removeClass('vencendo').removeClass('perdendo');
                var usuario_lance_atual = objTelao.getLoteAtualLanceAtual().usuario;
                if (objTelao.getLoteAtualLanceAtual().lance_id == '0') {
                    usuario_lance_atual = 'Seja o primeiro a dar lance';
                    $('.act-usuario-vencendo').html('&nbsp;');
                } else {
                    // coloca as mensagens de participacao no lote
                    if (objTelao.getLoteAtualLancesUsuario().length == 0) {
                        $('.act-usuario-vencendo').html('Voc&ecirc; n&atilde;o est&aacute; participando');
                    } else if (objTelao.getLoteAtualLanceAtual().usuario_vencendo == 0) {
                        $('.act-usuario-vencendo').addClass('perdendo').html('Seu lance foi superado');
                    } else {
                        $('.act-usuario-vencendo').addClass('vencendo').html('Voc&ecirc; est&aacute; vencendo');
                    }
                }

                $('.act-usuario-lance-atual').html(usuario_lance_atual);
            } catch(err) {
                this.erroTecnico(err)
            }
        },

        exibeMsgPorQuilo: function() {
            try {

                var tp_unidade = '';
                if (this.getLoteTpUnidade() == 'kg') {
                    tp_unidade = ' / ' + this.getLoteTpUnidade();
                } else if (this.getLoteTpUnidade() == 'm2') {
                    tp_unidade = ' / M&#178;';
                }
                return tp_unidade;
            } catch (err ){
                this.erroTecnico(err);
            }
        },

        exibirBotoesLance: function() {
            try {
                var objTelao = this;

                var simbolo_moeda = objTelao.getSimboloMoeda();

                $('.act-lista-botoes-lance').each(function() {
                    var $lista = $(this);
                    $lista.find('.act-btn-lance').each(function(i) {
                        var $botao = $(this);
                        var dados_botao = objTelao.getBotoesLance()[i];
                        $botao
                            .attr('data-vl-sugerido-real', dados_botao.vl_sugerido_real)
                            .html(dados_botao.vl_sugerido + objTelao.exibeMsgPorQuilo() + '<br /> Enviar');
                    });
                });

                // exibir lance automatico cadastrado
                $('.panel-lance-automatico .carregando').remove();
                if (objTelao.getLoteAtualLanceAutomatico() != '') {
                    $('.act-box-lance-automatico-atual').removeClass('hide').find('b').html(simbolo_moeda + ' ' + objTelao.getLoteAtualLanceAutomatico());
                    $('.act-form-lance-automatico').addClass('hide');
                } else {
                    $('.act-box-lance-automatico-atual').addClass('hide');
                    $('.act-form-lance-automatico').removeClass('hide');
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        fechamentoTelao: function(mensagem) {
            try {
                var objTelao = this;
                var $containerSemSessao = $('#containerSemSessao');
                $containerSemSessao.find('.mensagem').html(mensagem);

                $containerSemSessao.css('opacity', 0).removeClass('hide').stop().animate({
                    opacity: 1
                }, 300);
            } catch(err) {
                this.erroTecnico(err)
            }
        },



        exibirFotos: function() {
            try {
                var objTelao = this;

                if (objTelao.verificaMudancaLote()) {
                    var $slideshow = $('#slideshow');
                    objTelao.exibirFotoCarregando();
                    $slideshow.find('.control').addClass('hide');

                    clearTimeout(objTelao.lote_atual.fotos_timeout);
                    objTelao.lote_atual.fotos_timeout = setTimeout(function() {
                        var fotos = objTelao.getLoteAtualFotos();


                        if (fotos.length == 0) {
                            objTelao.exibirFotoIndisponivel();
                        } else {
                            objTelao.setLoteAtualFotoAtual(0);
                            objTelao.exibirFoto();
                        }
                    }, 1000);
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirFoto: function(callback_ok) {
            try {
                if (typeof callback_ok == 'undefined') {
                    callback_ok = function() {};
                }

                var objTelao = this;

                var fotos = objTelao.getLoteAtualFotos();
                var i_foto = objTelao.getLoteAtualFotoAtual();
                var foto = fotos[i_foto];

                objTelao.carregarFotoCache(
                    foto,
                    function() {
                        callback_ok();
                        objTelao.exibirFotoCarregada();
                        objTelao.prepararSlideFotos();
                    },
                    function() {
                        objTelao.exibirFotoIndisponivel();
                        objTelao.prepararSlideFotos();
                    },
                    function() {
                        objTelao.exibirFotoIndisponivel();
                        objTelao.prepararSlideFotos();
                    }
                );
            } catch(err) {
                this.erroTecnico(err)
            }
        },



        exibirFotoCarregando: function(target) {
            try {
                if (typeof target == 'undefined') {
                    target = 'current';
                }

                var $slideshow = $('#slideshow');
                var $img = $('<img src="/templates/telao/novo/img/imagem_carregando.jpg" alt="Carregando" class="img-responsive">');
                $slideshow.find('.inner .item.' + target).html($img);
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirFotoIndisponivel: function(target) {
            try {
                if (typeof target == 'undefined') {
                    target = 'current';
                }

                var $slideshow = $('#slideshow');
                var $img = $('<img src="/templates/telao/novo/img/imagem_indisponivel.jpg" alt="Foto indisponivel" class="img-responsive">');
                $slideshow.find('.inner .item.' + target).html($img);
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirFotoCarregada: function(target) {
            try {
                var objTelao = this;

                if (typeof target == 'undefined') {
                    target = 'current';
                }

                var fotos = objTelao.getLoteAtualFotos();
                var i_foto = objTelao.getLoteAtualFotoAtual();
                var fotos360 = objTelao.getFotos360();

                var foto = fotos[i_foto];
                var $slideshow = $('#slideshow');
                var control_prev = document.getElementById("control_prev");
                var control_next = document.getElementById("control_next");
                var zoom_telao = document.getElementById("zoom-telao");
                if(fotos360 != false) {
                    zoom_telao.style.display = "none";
                    control_prev.style.display = "none";
                    control_next.style.display = "none";
                    var $img = $('<iframe style="width:100%; height: 285px;" class="iframe360Modal" src="' + fotos360 + '!stscolor=2fa6e8!lang=pt-BR" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen=""></iframe>');
                } else {
                    zoom_telao.style.display = "block";
                    control_prev.style.display = "block";
                    control_next.style.display = "block";
                    var $img = $('<a href="' + foto + '?ims=1280x720" class="act-colorbox"><img src="' + foto + '?ims=800x600" alt="Foto ' + (i_foto + 1) + '" class="img-responsive"></a>');
                }

                $slideshow.find('.inner .item.' + target).html($img);
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        prepararSlideFotos: function() {
            try {
                var objTelao = this;

                var fotos = objTelao.getLoteAtualFotos();
                var i_foto = objTelao.getLoteAtualFotoAtual();
                var $slideshow = $('#slideshow');
                $slideshow.find('.inner .item.prev').empty();
                $slideshow.find('.inner .item.next').empty();
                for (var i in fotos) {
                    if (i < i_foto) {
                        $slideshow.find('.inner .item.prev').append('<div class="hide"><a href="' + fotos[i] + '?ims=1280x720" class="act-colorbox">' + fotos[i] + '</a></div>');
                    } else if (i > i_foto) {
                        $slideshow.find('.inner .item.next').append('<div class="hide"><a href="' + fotos[i] + '?ims=1280x720" class="act-colorbox">' + fotos[i] + '</a></div>');
                    }
                }

                $('.act-colorbox').colorbox({
                    rel: 'act-colorbox',
                    width: $(window).width() > 767 ? 'auto' : '100%',
                    onOpen: function() {
                        objTelao.sincronizar(false);
                    }
                });

                if (fotos.length > 1) {
                    $slideshow.find('.control').removeClass('hide');
                    $slideshow.find('.control').off('click').on('click', function(e) {
                        e.preventDefault();

                        var $btn = $(this);

                        if ($btn.hasClass('prev')) {
                            objTelao.trocarFoto('prev');
                        }
                        if ($btn.hasClass('next')) {
                            objTelao.trocarFoto('next');
                        }
                    });
                    $slideshow.find('.control').removeClass('active');
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        trocarFoto: function(acao) {
            try {
                var objTelao = this;

                var fotos = objTelao.getLoteAtualFotos();
                var i_foto_atual = objTelao.getLoteAtualFotoAtual();

                // ajax-loader.gif
                $('#slideshow .control.' + acao).addClass('active');
                if (acao == 'prev') {
                    i_foto_atual--;
                    if (i_foto_atual < 0) {
                        i_foto_atual = fotos.length - 1;
                    }
                } else if (acao == 'next') {
                    i_foto_atual++;
                    if (i_foto_atual >= fotos.length) {
                        i_foto_atual = 0;
                    }
                }

                objTelao.setLoteAtualFotoAtual(i_foto_atual);
                var foto = fotos[i_foto_atual];

                objTelao.exibirFotoCarregando(acao);

                objTelao.carregarFotoCache(
                    foto,
                    function() {
                        objTelao.exibirFotoCarregada(acao);
                        objTelao.moverFoto(acao, function() {
                            objTelao.prepararSlideFotos();
                        });
                    },
                    function() {
                        objTelao.exibirFotoIndisponivel(acao);
                        objTelao.moverFoto(acao, function() {
                            objTelao.prepararSlideFotos();
                        });
                    },
                    function() {
                        objTelao.exibirFotoIndisponivel(acao);
                        objTelao.moverFoto(acao, function() {
                            objTelao.prepararSlideFotos();
                        });
                    }
                );
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        moverFoto: function(acao, callback) {
            try {
                if (typeof callback == 'undefined') {
                    callback = function() {};
                }

                var objTelao = this;
                var $slideshow = $('#slideshow');
                $slideshow.find('.control').off('click').on('click', function(e) { e.preventDefault(); });

                if (acao == 'prev') {
                    var $slideshow = $('#slideshow');
                    $slideshow.addClass('animated').removeClass('side-next').addClass('side-prev');
                } else if (acao == 'next') {
                    var $slideshow = $('#slideshow');
                    $slideshow.addClass('animated').removeClass('side-prev').addClass('side-next');
                }

                setTimeout(function() {
                    objTelao.exibirFoto(function() {
                        $slideshow.removeClass('animated').removeClass('side-prev').removeClass('side-next');
                        callback();
                    });
                }, 700);
            } catch(err) {
                this.erroTecnico(err)
            }
        },



        exibirVideo: function() {
            try {
                var objTelao = this;

                if (objTelao.getLoteAtualTj() == '1') {
                    $('.panel-relogio').removeClass('hide');
                    if (objTelao.verificaMudancaLote()) {
                        objTelao.setLoteAtualRelogioIniciado(false);
                    }

                    // $("#boxVideo2").addClass('relogio').attr('data-countdown', objTelao.getLoteAtualTermino()).countdown();

                    $("#boxVideo").addClass('relogio').attr('data-countdown', objTelao.getLoteAtualTermino());

                    if (!objTelao.getLoteAtualRelogioIniciado()) {
                        objTelao.setLoteAtualRelogioIniciado(true);
                        $("#boxVideo").addClass('relogio').attr('data-countdown', objTelao.getLoteAtualTermino()).countdown(function(value, old_value) {
                            var $box = $("#boxVideo");

                            if (value.indexOf('ncerrado') != -1) {
                                objTelao.setLoteAtualRelogioIniciado(false);
                                $texto_normal = $box.find('.texto-normal');
                                if ($texto_normal.text().indexOf('omologando') != -1) {
                                    $texto_normal = '';
                                }
                                // coloco a div de texto normal
                                if ($texto_normal.length == 0) {
                                    $box.find('.texto-digital').remove();
                                    $box.html('<div class="texto-normal">Encerrado</div>');
                                }
                            } else if (value.indexOf('omologando') != -1 || value == '') {
                                objTelao.setLoteAtualRelogioIniciado(false);
                                $texto_normal = $box.find('.texto-normal');
                                // coloco a div de texto normal
                                if ($texto_normal.length == 0) {
                                    $box.find('.texto-digital').remove();
                                    $box.html('<div class="texto-normal">Homologando</div>');
                                }
                            } else {
                                objTelao.setLoteAtualRelogioIniciado(true);
                                var dias = 0;

                                if (value.indexOf('dia') != -1) {
                                    dias = parseInt(value.split(' ')[0]);
                                }

                                if (dias >= 1) {
                                    $texto_normal = $box.find('.texto-normal');
                                    // coloco a div de texto normal
                                    if ($texto_normal.length == 0) {
                                        $box.find('.texto-digital').remove();
                                        $box.html('<div class="texto-normal"></div>');
                                        $texto_normal = $box.find('.texto-normal');
                                    }

                                    if (dias == 1) {
                                        $texto_normal.text( dias + ' dia' );
                                        $('#relogioTj').text( dias + ' dia' );
                                    } else {
                                        $texto_normal.text( dias + ' dias' );
                                        $('#relogioTj').text( dias + ' dias' );
                                    }
                                } else {
                                    $texto_digital = $box.find('.texto-digital');
                                    // coloco a div de texto digital
                                    if ($texto_digital.length == 0) {
                                        $box.find('.texto-normal').remove();
                                        $box.html('<div class="texto-digital"></div>');
                                        $texto_digital = $box.find('.texto-digital');

                                        var html = '';
                                        html += '<div class="digito">';
                                        html +=     '<div class="barra centro topo"></div>';
                                        html +=     '<div class="barra centro meio"></div>';
                                        html +=     '<div class="barra centro baixo"></div>';
                                        html +=     '<div class="barra esquerda topo"></div>';
                                        html +=     '<div class="barra esquerda baixo"></div>';
                                        html +=     '<div class="barra direita topo"></div>';
                                        html +=     '<div class="barra direita baixo"></div>';
                                        html += '</div>';

                                        $texto_digital.append(html);
                                        $texto_digital.append(html);

                                        $texto_digital.append('<div class="pontos"><div class="ponto topo"></div><div class="ponto baixo"></div></div>');

                                        $texto_digital.append(html);
                                        $texto_digital.append(html);

                                        $texto_digital.append('<div class="pontos"><div class="ponto topo"></div><div class="ponto baixo"></div></div>');

                                        $texto_digital.append(html);
                                        $texto_digital.append(html);
                                    }

                                    $('#relogioTj').text( value );

                                    var hora = value.split(':');

                                    var h_a = hora[0][0];
                                    var h_b = hora[0][1];
                                    var m_a = hora[1][0];
                                    var m_b = hora[1][1];
                                    var s_a = hora[2][0];
                                    var s_b = hora[2][1];

                                    $texto_digital.find('.digito')
                                        .removeClass('d0')
                                        .removeClass('d1')
                                        .removeClass('d2')
                                        .removeClass('d3')
                                        .removeClass('d4')
                                        .removeClass('d5')
                                        .removeClass('d6')
                                        .removeClass('d7')
                                        .removeClass('d8')
                                        .removeClass('d9');

                                    $texto_digital.find('.digito').eq(0).addClass('d' + h_a);
                                    $texto_digital.find('.digito').eq(1).addClass('d' + h_b);
                                    $texto_digital.find('.digito').eq(2).addClass('d' + m_a);
                                    $texto_digital.find('.digito').eq(3).addClass('d' + m_b);
                                    $texto_digital.find('.digito').eq(4).addClass('d' + s_a);
                                    $texto_digital.find('.digito').eq(5).addClass('d' + s_b);

                                    if ($box.find('.pontos').eq(0).hasClass('ativo')) {
                                        $box.find('.pontos').removeClass('ativo');
                                    } else {
                                        $box.find('.pontos').addClass('ativo');
                                    }
                                }
                            }
                        });
                    }

                    // $('.panel-relogio').removeClass('hide');

                    // if (objTelao.getLoteAtualTermino() == 'Encerrado') {
                    //     if (objTelao.getLoteAtualRelogioIniciado() == 1) {
                    //         objTelao.setLoteAtualRelogioIniciado(false);

                        max_control: $lote.attr('max_control'),
                        tempo_aberto: $lote.attr('tempo_aberto'),
                        maior_lance: $lote.attr('maior_lance'),
                        st_lote: $lote.attr('st_lote')
                    });
                });
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        carregarRepasses: function() {
            try {
                var objTelao = this;

                objTelao.limpaRepasses([]);
                var $lotes_abertos = objTelao.getPingRetorno().find('repasses item');
                $lotes_abertos.each(function() {
                    var $lote = $(this);
                    objTelao.pushRepasses({
                        number: $lote.attr('nu_lote'),
                        value: $lote.attr('vl_maior_lance'),
                        lote_id: $lote.attr('lote_id'),
                        status: $lote.attr('st_lote'),
                    });
                });
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        carregarFotos: function() {
            try {
                var objTelao = this;

                objTelao.limpaLoteAtualFotos();
                var $fotos = objTelao.getPingRetorno().find('fotos imagem');
                var $tagDesocupado = $("#tagImovelDesocupado");

                if (objTelao.getTipoSegmento() == 'i' && objTelao.getImovelDesocupado() > 0) {
                    $tagDesocupado.removeClass('hide');
                } else {
                    $tagDesocupado.addClass('hide');
                }

                $fotos.each(function() {
                    var $foto = $(this);
                    var src = $foto.attr('src');

                    if ($.trim(src) != '') {
                        objTelao.pushLoteAtualFotos($.trim(src));
                    }
                });
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        carregarVideo: function() {
            try {
                var objTelao = this;

                objTelao.exibirVideo();
            } catch(err) {
                this.erroTecnico(err)
            }
        },

        /* condicoes de venda */
        abrirCondicoes: function(callback_aceitar) {
            try {
                var objTelao = this;
                callback_aceitar = callback_aceitar || function() {};

                let originAl = '';
                if (parseInt(this.getLoteAl()) > 0) {
                    originAl = '?origin=al';
                }
                
                var url = '/condicoes/' + objTelao.getLeilaoId() + '/' + originAl;
                $.get(url, function(retorno) {
                    var condicao = $(retorno).find('> div > div').html();
                    var formAskImovel = $(retorno)[$(retorno).length - 1];
                    objTelao.abrirCondicoesView(condicao, callback_aceitar);
                    $("#form-ask").html(formAskImovel);
                });
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        abrirCondicoesView: function(condicao, callback_aceitar) {
            try {
                var objTelao = this;
                callback_aceitar = callback_aceitar || function() {};

                // coloco o texto no html
                if (objTelao.getCondicoesVendaAceita()) {
                    $('#boxCondicoesVenda').find('.act-aceitar-condicoes-venda').hide();
                    $('#boxCondicoesVenda').find('.act-mensagem-condicoes-venda').show();
                } else {
                    $('#boxCondicoesVenda').find('.act-aceitar-condicoes-venda').show();
                    $('#boxCondicoesVenda').find('.act-mensagem-condicoes-venda').hide();
                }

                var title = 'CONDI&Ccedil;&Otilde;ES DE VENDA DO LEIL&Atilde;O ';
                var data_title = $('#boxCondicoesVenda').attr('data-title');

                if(typeof data_title != 'undefined') {
                    title = data_title;
                }

                $('#boxCondicoesVenda').find('.modal-body .well').css('text-align', 'center').html(condicao);
                $('#boxCondicoesVenda').find('#boxCondicoesVendaLabel').html(title + objTelao.getLeilaoId());
                $('#boxCondicoesVenda').modal({
                    backdrop: false,
                    keyboard: false
                });

                $('#boxCondicoesVenda').off('show.bs.modal').on('show.bs.modal', function() {
                    objTelao.setCondicoesVendaAberta(true);
                });
                $('#boxCondicoesVenda').off('shown.bs.modal').on('shown.bs.modal', function() {
                    $('#boxCondicoesVenda').find('.modal-footer button:not([disabled])').eq(0).focus();
                });
                $('#boxCondicoesVenda').off('hidden.bs.modal').on('hidden.bs.modal', function() {
                    objTelao.setCondicoesVendaAberta(false);
                });

                // seto as acoes
                $('.act-fechar-condicoes-venda').off('click').on('click', function(e) {
                    e.preventDefault();
                    objTelao.fecharCondicoes(callback_aceitar);
                });

                $('.act-aceitar-condicoes-venda').off('click').on('click', function(e) {
                    e.preventDefault();
                    objTelao.aceitarCondicoes(callback_aceitar);
                });
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        fecharCondicoes: function(callback_aceitar) {
            try {
                var objTelao = this;
                callback_aceitar = callback_aceitar || function() {};

                objTelao.setCondicoesVendaAberta(false);
                objTelao.fecharCondicoesView();
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        fecharCondicoesView: function(callback_aceitar) {
            try {
                var objTelao = this;
                callback_aceitar = callback_aceitar || function() {};

                $('#boxCondicoesVenda').off('hidden.bs.modal').on('hidden.bs.modal', function() {
                    callback_aceitar();
                });
                $('#boxCondicoesVenda').modal('hide');
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        aceitarCondicoes: function(callback_aceitar) {
            try {
                var objTelao = this;
                callback_aceitar = callback_aceitar || function() {};

                var url = '/condicoes/' + objTelao.getLeilaoId() + '/';

                //QUESTIONARIO IMOVEIS CONDICAO DE VENDAS
                var formAskImovel = $(".form-cond-sales");
                var askoptions = new Array;
                var conditionSalesAskFill = true;

                var data = { aceito: 1, leilao_id: objTelao.getLeilaoId()};

                if (formAskImovel.length > 0) {
                    $('.formBradesco').each(function() {
                        var name = $(this).attr("name");
                        if(typeof $('.formBradesco[name="'+name+'"]:checked').val() == 'undefined' && name != "st_lote_interesse"){
                            conditionSalesAskFill = false;
                        } else if ($('.formBradesco[name="'+name+'"]').val().trim() == "" && name == "st_lote_interesse") {
                            conditionSalesAskFill = false;
                        }
                        askoptions[name] = $('.formBradesco[name="'+name+'"]').val();
                    })

                    data = {
                        aceito: 1,
                        leilao_id: objTelao.getLeilaoId(),
                        'st_bradesco': askoptions['st_bradesco'],
                        'st_finalidade': askoptions['st_finalidade'],
                        'st_participou': askoptions['st_participou'],
                        'st_arrematou': askoptions['st_arrematou'],
                        'st_lote_interesse': askoptions['st_lote_interesse'],
                        'st_categoria': askoptions['st_categoria']
                    }
                }

                if (!conditionSalesAskFill) {
                    alert('Favor responder o questionario');
                    return false;
                }

                $.post(url, data, function() {
                    objTelao.setCondicoesVendaAceita(true);
                    objTelao.aceitarCondicoesView(callback_aceitar);
                });
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        aceitarCondicoesView: function(callback_aceitar) {
            try {
                var objTelao = this;
                callback_aceitar = callback_aceitar || function() {};

                objTelao.fecharCondicoesView(callback_aceitar);
            } catch(err) {
                this.erroTecnico(err)
            }
        },

        // metodos de exibicao
        exibirDadosLeilao: function() {
            try {
                var objTelao = this;                
                $('.act-detalhes-leilao').html(objTelao.getLeilaoNome());

                objTelao.exibirListaLotes();
                objTelao.exibirLotesAbertos();
                objTelao.exibirRepasses();
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirListaLotes: function() {
            try {
                var objTelao = this;

                // limpo o select dos lotes
                var $select_lista_lotes = $('.act-lista-lotes');
                var item_selecionado = $.trim($select_lista_lotes.val());
                $select_lista_lotes.val('');
                $select_lista_lotes.html('');

                // percorro os lotes e coloco no select
                for (var i in objTelao.getListaLotes()) {
                    var item = objTelao.getListaLotes()[i];
                    var $option = $('<option value="' + item.lote_id + '">Lote ' + item.nu_lote + '</option>');
                    $select_lista_lotes.append($option);
                }

                // coloco o lote atual
                if (objTelao.verificaMudancaLote()) {
                    $select_lista_lotes.val(objTelao.getLoteIdAtual());
                } else {
                    if (item_selecionado != '') {
                        $select_lista_lotes.val(item_selecionado);
                    } else {
                        $select_lista_lotes.val(objTelao.getLoteIdAtual());
                    }
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirLotesAbertos: function() {
            try {
                var objTelao = this;

                var lotes_abertos = objTelao.getLotesAbertos();
                var maximo = 8;

                if (maximo > lotes_abertos.length) {
                    maximo = lotes_abertos.length;
                }

                $('.act-lotes-abertos .box-slide').html('');

                if (maximo) {
                    for (var i = 0; i < maximo; i++) {
                        var item = lotes_abertos[i];
                        var classe_status = '';
                        switch (item.st_lote) {
                            case '1': classe_status = 'aguardando'; break;
                            case '2': classe_status = 'dou-lhe-uma'; break;
                            case '3': classe_status = 'dou-lhe-duas'; break;
                            case '4': classe_status = 'pregao'; break;
                            case '5': classe_status = 'vendido'; break;
                            case '6': classe_status = 'nao-vendido'; break;
                            case '7': classe_status = 'condicional'; break;
                            case '8': classe_status = 'repasse'; break;
                            case '9': classe_status = 'retirado'; break;
                        }
                        $('.act-lotes-abertos .box-slide').append('<a href="#" data-lote-id="' + item.lote_id + '" class="lote-aberto-item status-' + classe_status + '">' + item.lote + '</a>');
                    }
                } else {
                    $('.act-lotes-abertos .box-slide').html('<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Nenhum lote aberto');
                }

                $('.act-lotes-abertos .box-slide a').off('click').on('click', function(e) {
                    e.preventDefault();

                    objTelao.mudarLote($(this).attr('data-lote-id'));
                });

                $('.act-quantidade-lotes-abertos').html('(' + maximo + ')');
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirRepasses: function() {
            try {
                var objTelao = this;
                var repasses = objTelao.getRepasses();

                if (objTelao.leilao.repassesQtd !== repasses.length) {
                    try {
                        $('.slick-autoplay').slick('unslick');
                    } catch (error) {}

                    $('.act-repasse').html('');
                    for (var i in repasses) {
                        var item = repasses[i];
                        $('.act-repasse').append('<div class="slick-slide act-select-repass" data-lote-id="' + item.lote_id + '"><div class="slick-box"><p>' + item.number + '</p><span>R$ ' + item.value + '</span></div></div>');
                    }

                    $('.slick-autoplay').slick({
                        infinite: true,
                        slidesToShow: 8,
                        // slidesToScroll: 1,
                        autoplaySpeed: 2000,
                        autoplay: repasses.length >= 8 ? true : false,
                        slidesToShow: 8,
                        responsive: [
                            {
                                breakpoint: 767,
                                settings: {
                                    autoplay: repasses.length >= 6 ? true : false,
                                    slidesToShow: 6,
                                }
                            },
                            {
                                breakpoint: 480,
                                settings: {
                                    autoplay: repasses.length >= 3 ? true : false,
                                    slidesToShow: 3,
                                }
                            }
                        ]
                    });

                    objTelao.leilao.repassesQtd = repasses.length
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirEncerramentoLeilao: function() {
            try {
                var objTelao = this;
                var encerrado = objTelao.getEncerrado();

                var $containerFinalizacao = $('#containerFinalizacao');

                $containerFinalizacao.css('opacity', 0).removeClass('hide').stop().animate({
                    opacity: 1
                }, 300);
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirDadosLote: function() {
            try {
                var objTelao = this;

                $('.act-titulo-lote-atual').html(objTelao.getLoteAtualNumero() + ' - ' + objTelao.getLoteAtualNome());

                if (objTelao.getLoteAtualDescricao() == '') {
                    $('.act-descricao-lote-atual').html('-- Sem descri&ccedil;&atilde;o --');
                } else {
                    $('.act-descricao-lote-atual').html(objTelao.getLoteAtualDescricao());
                }

                objTelao.exibirStatusLote();
                objTelao.exibirMensagem();
                objTelao.exibirLances();
                objTelao.exibirLanceAtual();
                objTelao.exibirBotoesLance();
                objTelao.exibirFotos();
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirStatusLote: function() {
            try {
                var objTelao = this;

                var status = '';
                var classe_status = '';
                switch (objTelao.getLoteAtualStatus()) {
                    case '1': status = 'Aberto'; classe_status = 'aguardando'; break;
                    case '2': status = 'Dou-lhe Uma'; classe_status = 'dou-lhe-uma'; break;
                    case '3': status = 'Dou-lhe Duas'; classe_status = 'dou-lhe-duas'; break;
                    case '4': status = 'Preg&atilde;o'; classe_status = 'pregao'; break;
                    case '5': status = 'Vendido'; classe_status = 'vendido'; break;
                    case '6': status = 'N&atilde;o Vendido'; classe_status = 'nao-vendido'; break;
                    case '7': status = 'Condicional'; classe_status = 'condicional'; break;
                    case '8': status = 'Repasse'; classe_status = 'repasse'; break;
                    case '9': status = 'Retirado'; classe_status = 'retirado'; break;
                }
                $('.act-status-lote-atual')
                    .removeClass('aguardando')
                    .removeClass('dou-lhe-uma')
                    .removeClass('dou-lhe-duas')
                    .removeClass('pregao')
                    .removeClass('vendido')
                    .removeClass('nao-vendido')
                    .removeClass('condicional')
                    .removeClass('repasse')
                    .removeClass('retirado');

                /* ### DIREITO DE PREFERENCIA ### */
                // console.log(objTelao.lote_atual)
                if (objTelao.lote_atual.lote_id == 2355368) {
                    status += ' por Direito de Prefer&ecirc;ncia';
                }

                // leilao A.P santos
                if (objTelao.leilao.leilao_id == '23281' && objTelao.getLoteAtualStatus() == 6) {
                    status = 'Aberto para Lances at&eacute; 16/12 14H';
                }                
                
                $('.act-status-lote-atual').addClass(classe_status).html(status);
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirMensagem: function() {
            try {
                var objTelao = this;
                var mensagem = $.trim(objTelao.getLoteAtualMensagem());

                if (objTelao.leilao.leilao_id == 23120 && objTelao.getLoteAtualStatus() == 6) {
                    mensagem = 'Interessado devem enviar sua proposta para o e-mail comercial@sodresantoro.com.br';
                }
                                
                if (mensagem == '') {
                    $('.act-mensagem-lote-atual').removeClass('ativo').html('');
                } else {
                    $('.act-mensagem-lote-atual').addClass('ativo').html(mensagem);
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirLances: function() {
            try {
                var objTelao = this;

                // var simbolo_moeda = objTelao.getSimboloMoeda();

                // if (objTelao.getLoteAtualLances().length == 0) {
                //     var html = '';
                //     html += '<table class="table">';
                //     html += '   <thead>';
                //     html += '       <tr>';
                //     html += '           <th>n&ordm;</th>';
                //     // html += '           <th>Usu&aacute;rio</th>';
                //     html += '           <th class="text-right">Lance (' + simbolo_moeda + ')</th>';
                //     html += '       </tr>';
                //     html += '   </thead>';
                //     html += '   <tbody>';
                //     html += '       <tr>';
                //     html += '           <td colspan="2" class="text-center"><b>Nenhum lance enviado at&eacute; o momento.</b></td>';
                //     html += '       </tr>';

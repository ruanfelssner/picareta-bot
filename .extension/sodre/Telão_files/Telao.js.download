                } else {
                    $('.panel-relogio').addClass('hide');
                    objTelao.setLoteAtualRelogioIniciado(false);

                    if (objTelao.getMedidaWidth() >= 992) {

                        // pego a imagem anterior para nao ficar piscando o video toda hora no browser
                        var imagem_anterior = objTelao.getVideoImagemUtilizada();

                        // verifico a imagem que sera usada
                        if (objTelao.getDataHoraAntes() == 1) {
                            objTelao.setVideoImagemUtilizada(objTelao.getVideoImagemIndisponivel());
                        } else if (objTelao.getDataHoraDurante() == 1) {
                            objTelao.setVideoImagemUtilizada(objTelao.getVideoImagemDisponivel());
                        } else if (objTelao.getDataHoraDepois() == 1) {
                            objTelao.setVideoImagemUtilizada(objTelao.getVideoImagemEncerrado());
                        }

                        // se houve alteracao na imagem que sera usada, refaco o plugin do video
                        if (imagem_anterior != objTelao.getVideoImagemUtilizada()) {
                            // objTelao.exibirPluginVideo(objTelao);
                            objTelao.exibirPluginAntigoVideo(objTelao);
                        }
                    }
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirPluginVideo: function() {
            try {
                var objTelao = this;

                // // fixo a altura do video para nao dar problema no HTML
                // var height = $('.panel.video').height();
                // $('.panel.video').height(height);

                var video = jwplayer('boxVideo');

                if (!objTelao.getVideoAtivo()) {
                    video.setup({
                        playlist: [
                            {
                                image: objTelao.getVideoImagemUtilizada(),
                                sources: [
                                    {
                                        file: objTelao.getVideoUrlStreaming() + objTelao.getLeilaoId(),
                                        // file: objTelao.getVideoUrlStreaming() + 'sswebtv',
                                        // file: 'rtmp://q5ssolfms35ra.nethorizontes.com.br/q5ssolfms35ra/' + objTelao.getLeilaoId(),
                                    },
                                    {
                                        file: 'http://egina.nethorizontes.tv:1935/tgc1210fms35/' + objTelao.getLeilaoId() + '/playlist.m3u8',
                                        type: 'mp4',
                                    }
                                ]
                            }
                        ],
                    });
                    $('#boxVideoPanelBody').addClass('ativo');
                }

                // // retiro a altura fixa do box para nao quebrar o responsivo
                // video.on('ready', function(a) {
                //     $('.panel.video').css('height', 'auto');
                // });

                video.on('play', function() {
                    objTelao.setVideoAtivo(true);
                });

                video.on('pause', function() {
                    objTelao.setVideoAtivo(false);
                });

                video.on('stop', function() {
                    objTelao.setVideoAtivo(false);
                });

                // quando der erro eu abro a modal de erro
                video.on('error', function(a) {
                    // objTelao.setVideoPing(true);

                    objTelao.setVideoAtivo(false);
                    objTelao.exibirErroVideo(objTelao);
                    if (objTelao.getNavegadorNome() != 'ie') {
                        objTelao.exibirPluginVideo(objTelao);
                    }
                });
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirPluginAntigoVideo: function() {
            try {
                var objTelao = this;

                // var html = '<object classid="clsid:d27cdb6e-ae6d-11cf-96b8-444553540000" codebase="http://fpdownload.macromedia.com/pub/shockwave/cabs/flash/swflash.cab#version=9,0,18,0" width="272" height="252">' +
                //                 '<param name="movie" value="/templates/telao/novo/flash/telao.swf"  />' +
                //                 '<param name="wmode" value="transparent"/>' +
                //                 '<embed src="/templates/telao/novo/flash/telao.swf"  width="272" height="252" name="fullscreen" align="middle" type="application/x-shockwave-flash" pluginspage="http://www.macromedia.com/go/getflashplayer" />' +
                //             '</object>';
                var html = '<h1 class="text-center" style="line-height: 222px;">V&iacute;deo OFF</h1>';
                $('#boxVideo').html(html);
                $('#boxVideoPanelBody').addClass('ativo');
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        exibirErroVideo: function() {
            try {
                var objTelao = this;

                objTelao.abrirMensagem({
                    titulo: 'Erro na transmiss&atilde;o do v&iacute;deo',
                    botaoFechar: true,
                    mensagem: '<span style="color: #a00;">Ocorreu um erro na transmiss&atilde;o do v&iacute;deo ao vivo do leil&atilde;o. Por favor, tente novamente.</span>',
                    centralizar: true,
                    botoes: [
                        {
                            rotulo: 'Fechar',
                            classe: 'default',
                            fechar: true
                        }
                    ]
                });
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        tamanhoImagem: function(imagem, tamanho) {
            try {
                if (typeof tamanho == 'undefined') {
                    tamanho = '194x143';
                }

                var imagem_tmp = imagem.split('/');
                imagem_tmp[5] = imagem_tmp[4];
                imagem_tmp[4] = '194x143';
                imagem_tmp = imagem_tmp.join('/');

                return imagem_tmp;
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        carregarFotoCache: function(foto, callback_ok, callback_erro, callback_timeout) {
            try {
                if (typeof callback_erro == 'undefined') {
                    callback_erro = function() {};
                }

                if (typeof callback_timeout == 'undefined') {
                    callback_timeout = function() {};
                }

                var exec_callback_ok = true;

                var imagem = new Image();
                imagem.src = foto;
                imagem.onload = function() {
                    if (exec_callback_ok) {
                        callback_ok();
                    }
                };
                imagem.onerror = callback_erro;

                setTimeout(function() {
                    if (!imagem.complete) {
                        exec_callback_ok = false;
                        callback_timeout();
                    }
                }, 10000);
            } catch(err) {
                this.erroTecnico(err)
            }
        },

        // as acoes dos componentes do telao
        acoes: function() {
            try {
                var objTelao = this;

                // ações de entrar e sair da tela
                {
                    $(window).off('blur').on('blur', function(e) {
                        objTelao.sairJanela();
                    });

                    $(window).off('focus').on('focus', function(e) {
                        objTelao.entrarJanela();
                    });
                }

                // passar fotos
                {
                    // $('.act-passar-foto-menos').off('click').on('click', function(e) {
                    //     e.preventDefault();

                    //     var foto_atual = objTelao.getLoteAtualFotoAtual();
                    //     var quantidade_foto = objTelao.getLoteAtualQuantidadeFotos();

                    //     if (quantidade_foto) {
                    //         foto_atual--;
                    //         if (foto_atual == 0) {
                    //             foto_atual = quantidade_foto;
                    //         }

                    //         $('.act-fotos-lote-atual .imagens-lote a').removeClass('ativo').eq(foto_atual - 1).addClass('ativo');
                    //         objTelao.setLoteAtualFotoAtual(foto_atual);
                    //     }
                    // });
                }

                // passar lote
                {
                    $('.act-passar-foto-mais').off('click').on('click', function(e) {
                        e.preventDefault();

                        var foto_atual = objTelao.getLoteAtualFotoAtual();
                        var quantidade_foto = objTelao.getLoteAtualQuantidadeFotos();

                        if (quantidade_foto) {
                            foto_atual++;
                            if (foto_atual > quantidade_foto) {
                                foto_atual = 1;
                            }

                            $('.act-fotos-lote-atual .imagens-lote a').removeClass('ativo').eq(foto_atual - 1).addClass('ativo');
                            objTelao.setLoteAtualFotoAtual(foto_atual);
                        }
                    });

                    var loteArray = objTelao.getListaLotes();
                    var novoArray = [];
                    loteArray.forEach(function(item){
                        novoArray.push(parseInt(item.lote_id));
                    });
                    var tamanho = novoArray.length;

                    var atual = novoArray.indexOf(objTelao.getLoteIdAtual());

                    var cliques = 0;
                    var called = false;

                    $('.act-passar-lote-menos').off('click').on('click', function(e) {
                        e.preventDefault();
                        cliques++;
                        called = true;
                        setTimeout(function(){
                            if (called == true) {

                                nova = parseInt(atual) - parseInt(cliques);
                                if (nova < 0) {
                                    nova = 0;
                                }
                                //objTelao.mudarLote('menos');
                                objTelao.mudarLote(novoArray[nova]);
                                called = false;
                            }
                        }, 1000);
                    });

                    $('.act-passar-lote-mais').off('click').on('click', function(e) {
                        e.preventDefault();
                        cliques++;
                        called = true;
                        setTimeout(function() {
                            if (called == true) {

                                nova = parseInt(cliques)+parseInt(atual);
                                if (nova > tamanho) {
                                    nova = tamanho;
                                }
                                //objTelao.mudarLote('mais');
                                objTelao.mudarLote(novoArray[nova]);
                                called = false;
                            }
                        }, 1000);

                    });

                }

                // abrir condicoes de vendas
                $('.act-abrir-condicoes-venda').off('click').on('click', function(e) {
                    e.preventDefault();
                    objTelao.abrirCondicoes();
                });

                // atualizar lista de lotes
                $('.act-lista-lotes').off('change').on('change', function(e) {
                    e.preventDefault();
                    var lote_id = $(this).val();
                    objTelao.mudarLote(lote_id);
                });

                // botoes de lances
                {

                    // o lance esta liberado para status:
                    // 1 - aberto
                    // 2 - doulhe-uma
                    // 3 - doulhe-duas
                    // 4 - pregao
                    // 8 - repasse
                    var descTermino  = objTelao.getLoteAtualTermino();
                    var eh_tj = objTelao.getLoteAtualTj();
                    var status = objTelao.getLoteAtualStatus();
                    var status_liberado = [1, 2, 3, 4, 8];
                    if ((in_array(status, status_liberado) && eh_tj == 0) || (in_array(status, status_liberado) && eh_tj == 1 && descTermino != 'Homologando')) {
                    // if (in_array(status, status_liberado) ) {
                        $('.act-lista-botoes-lance').find('.act-btn-lance')
                            .off('click')
                            .on('click', function(e) {
                                e.preventDefault();

                                var $btn = $(this);
                                var vl_sugerido_real = $btn.attr('data-vl-sugerido-real');
                                objTelao.mensagemLance(vl_sugerido_real);
                            })
                            .removeAttr('disabled')
                            .removeClass('disabled');

                        $('.act-abrir-outros-lances')
                            .off('click')
                            .on('click', function(e) {
                                e.preventDefault();
                                objTelao.exibirOutrosLances();
                            })
                            .removeAttr('disabled')
                            .removeClass('disabled');

                        $('.act-abrir-lances-automatico')
                            .off('click')
                            .on('click', function(e) {
                                e.preventDefault();
                                objTelao.exibeLancesAutomaticos(objTelao);
                            })
                            .removeAttr('disabled')
                            .removeClass('disabled');

                        $('.act-excluir-lance-automatico')
                            .off('click')
                            .on('click', function(e) {
                                e.preventDefault();
                                objTelao.mensagemExcluirLanceAutomatico();
                            })
                            .removeAttr('disabled')
                            .removeClass('disabled');
                    } else {
                        var mensagem_erro = '';
                        if (status == 5) {
                            mensagem_erro = '<p>Este lote n&atilde;o pode mais receber lances porque ele foi vendido.</p>';
                        } else if (status == 6) {
                            mensagem_erro = '<p>Este lote n&atilde;o pode mais receber lances porque ele n&atilde;o foi vendido.</p>';
                        } else if (status == 7) {
                            mensagem_erro = '<p>Este lote n&atilde;o pode mais receber lances porque ele est&aacute; em condicional.</p>';
                        } else if (status == 9) {
                            mensagem_erro = '<p>Este lote n&atilde;o pode mais receber lances porque ele foi retirado.</p>';
                        }

                        $('.act-lista-botoes-lance').find('.act-btn-lance')
                            .off('click')
                            .on('click', function(e) {
                                e.preventDefault();

                                objTelao.abrirMensagem({
                                    titulo: 'Lances bloqueados',
                                    botaoFechar: true,
                                    mensagem: mensagem_erro,
                                    largura: 680,
                                    altura: 200,
                                    botoes: [
                                        {
                                            rotulo: 'Fechar',
                                            classe: 'default',
                                            fechar: true
                                        }
                                    ]
                                });
                            })
                            .attr('disabled', 'disabled')
                            .addClass('disabled');

                        $('.act-abrir-outros-lances')
                            .off('click')
                            .on('click', function(e) {
                                e.preventDefault();

                                objTelao.abrirMensagem({
                                    titulo: 'Lances bloqueados',
                                    botaoFechar: true,
                                    mensagem: mensagem_erro,
                                    largura: 680,
                                    altura: 200,
                                    botoes: [
                                        {
                                            rotulo: 'Fechar',
                                            classe: 'default',
                                            fechar: true
                                        }
                                    ]
                                });
                            })
                            .attr('disabled', 'disabled')
                            .addClass('disabled');

                        $('.act-abrir-lances-automatico')
                            .off('click')
                            .on('click', function(e) {
                                e.preventDefault();

                                objTelao.abrirMensagem({
                                    titulo: 'Lances bloqueados',
                                    botaoFechar: true,
                                    mensagem: mensagem_erro,
                                    largura: 680,
                                    altura: 200,
                                    botoes: [
                                        {
                                            rotulo: 'Fechar',
                                            classe: 'default',
                                            fechar: true
                                        }
                                    ]
                                });
                            })
                            .attr('disabled', 'disabled')
                            .addClass('disabled');

                        $('.act-excluir-lance-automatico')
                            .off('click')
                            .on('click', function(e) {
                                e.preventDefault();

                                    objTelao.abrirMensagem({
                                        titulo: 'Lances bloqueados',
                                        botaoFechar: true,
                                        mensagem: mensagem_erro,
                                        largura: 680,
                                        altura: 200,
                                        botoes: [
                                            {
                                                rotulo: 'Fechar',
                                                classe: 'default',
                                                fechar: true
                                            }
                                        ]
                                    });
                            })
                            .attr('disabled', 'disabled')
                            .addClass('disabled');
                    }
                }

                // icone de duvida de lance automatico
                $('.iconDuvida').popover({
                    content: 'Voc&ecirc; estipula um valor m&aacute;ximo para o lance e o sistema disputa por voc&ecirc;.',
                    placement: 'top',
                    trigger: 'hover focus',
                    html: true
                });

                // sincronizar leilao
                $('#sincronizar').off('click').on('click', function(e) {
                    e.preventDefault();

                    var $btn = $(this);


                    if (objTelao.getPingSincronizado()) {
                        objTelao.sincronizar(false);
                    } else {
                        objTelao.sincronizar(true);
                    }
                });

                // fechar janela
                $('#btnFecharJanela').off('click').on('click', function(e) {
                    e.preventDefault();

                    if (confirm('Deseja fechar esta janela?')) {
                        window.close()
                    }
                });
            } catch(err) {
                this.erroTecnico(err)
            }

            $('.act-select-repass').off('click').on('click', function(e) {
                e.preventDefault();
                let lotId = $(this).attr('data-lote-id')

                objTelao.mudarLote(lotId);
            })

            // $('.act-enviar-outro-valor').off('click').on('click', function(e) {
            //     e.preventDefault();
            //     var vl_sugerido_real = parseFloat($('.act-outros-lances').val());
            //     alert(vl_sugerido_real);
            //     // objTelao.mensagemLance(vl_sugerido_real);
            // })
        },
    };

    return Telao;
})(objTelaoExibicao);

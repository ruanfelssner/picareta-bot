                // } else {
                    var html = '';
                    var cabecalhoLance = 'Comiss&atilde;o + <br /> Outros Pagtos';
                    var cabecalhoTotal = 'Valor Total';
                    if (objTelao.getStAlterarCabecalho()) {
                        cabecalhoLance = 'Comiss&atilde;o';
                        cabecalhoTotal = 'Lance + Comiss&atilde;o';
                    }
                    
                    var textoDesconto = "";
                    if (objTelao.getLeiloesBlackFriday().includes(objTelao.leilao.leilao_id)) {
                        textoDesconto = '<br> <small style="font-size:10px">j&aacute; c/ desconto de 5%</small>';

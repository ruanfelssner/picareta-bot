        getEncerrado: function() { return this.leilao.encerrado; },

        setSimboloMoeda: function(a) { this.leilao.simbolo_moeda = a; },
        getSimboloMoeda: function() { return this.leilao.simbolo_moeda; },

        setLeiloesDolar: function(a) { this.leilao.leiloes_dolar = a; },
        getLeiloesDolar: function() { return this.leilao.leiloes_dolar; },

        getLeiloesBlackFriday: function() { return [24814] },
        
        setObjectInsider: function(sslo_status) {
            var segmento = 'veiculos';
            if (sslo_status.find('lote').attr('tipo_segmento') == 'I') {
                segmento = 'imoveis';
            } else if (sslo_status.find('lote').attr('tipo_segmento') == 'M') {
                segmento = 'materiais';
            }
            
            this.insiderEventObject[segmento].comitente = sslo_status.find('detalhe').attr('comitente');            
            this.insiderEventObject[segmento].categoria = sslo_status.find('detalhe').attr('categoria');                        
            this.insiderEventObject[segmento].descricao = sslo_status.find('lote').attr('desc_lote');                        
            this.insiderEventObject[segmento].tj = parseInt(sslo_status.find('detalhe').attr('tj')) > 0 ? 'judicial' : '';                                
            
            if ('marca' in this.insiderEventObject[segmento]) {                
                this.insiderEventObject[segmento].marca = sslo_status.find('detalhe').attr('marca');
            }
            if ('modelo' in this.insiderEventObject[segmento]) {
                this.insiderEventObject[segmento].modelo = sslo_status.find('detalhe').attr('modelo');                
            }            
            if ('patio' in this.insiderEventObject[segmento]) {
                this.insiderEventObject[segmento].patio = sslo_status.find('detalhe').attr('patio');                
            }            
            
            if (sslo_status.find('lote').attr('tipo_segmento') == 'I') {
                this.insiderEventObject.imoveis.mt_total = sslo_status.find('detalhe').attr('mt_area_total');
                this.insiderEventObject.imoveis.mt_util = sslo_status.find('detalhe').attr('mt_area_construida');
                this.insiderEventObject.imoveis.bairro = sslo_status.find('detalhe').attr('bairro');
                this.insiderEventObject.imoveis.cidade = sslo_status.find('detalhe').attr('cidade');
                this.insiderEventObject.imoveis.estado = sslo_status.find('detalhe').attr('estado');
                this.insiderEventObject.imoveis.ocupacao = sslo_status.find('detalhe').attr('ocupacao');
            } else if (sslo_status.find('lote').attr('tipo_segmento') == 'M') {
                this.insiderEventObject.materiais.subcategoria = sslo_status.find('detalhe').attr('subcategoria');                                
            } else {
                this.insiderEventObject.veiculos.monta = sslo_status.find('detalhe').attr('monta');  
                this.insiderEventObject.veiculos.ano_fab = sslo_status.find('detalhe').attr('ano_fabricacao');  
                this.insiderEventObject.veiculos.ano_mod = sslo_status.find('detalhe').attr('ano_modelo');  
                this.insiderEventObject.veiculos.cor = sslo_status.find('detalhe').attr('cor');
                this.insiderEventObject.veiculos.combustivel = sslo_status.find('detalhe').attr('combustivel');
                this.insiderEventObject.veiculos.km = sslo_status.find('detalhe').attr('km');
                this.insiderEventObject.veiculos.origem = sslo_status.find('detalhe').attr('origem');
            }                                                            
        },
        
        getObjectInsider: function() {
            return this.insiderEventObject;
        },

        // funcoes
        formataNumero: function(a) { try { a = parseInt(a); if(!isNaN(a)) { return a; } return null; } catch(err) { this.erroTecnico(err); } },
        formataId: function(a) { try { a = parseInt(a); if(!isNaN(a) && a > 0) { return a; } return null; } catch(err) { this.erroTecnico(err); } },
        formataBool: function(a) { try { if (a) { return true; } return false; } catch(err) { this.erroTecnico(err); } },
        formataNome: function(nome, cidade, uf) {
            let retorno = `${nome}`            
            
            // if (cidade != '' && uf != '') {
            //     retorno += ` - ${cidade}/${uf} `
            // }

            return retorno;
        },
        montaPingUrl: function(lote_id) {
            try {
                var lote_id = lote_id || false;
                var url = this.getPingUrl().split('/');
                url.push('leilao_id');
                url.push(this.getLeilaoId());
                if (lote_id) {
                    url.push('lote_id');
                    url.push(lote_id);
                }
                url = url.join('/');
                return url;
            } catch(err) {
                this.erroTecnico(err)
            }
        },        
        verificaMudancaLote: function() {
            try {
                return this.getLoteIdAtual() != this.getLoteIdAnterior();
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        mudarLote: function(acao) {
            try {
                var objTelao = this;

                if (acao == 'mais') {
                    objTelao.mudarLote(objTelao.getLeilaoLoteIdProximo());
                } else if (acao == 'menos') {
                    objTelao.mudarLote(objTelao.getLeilaoLoteIdAnterior());
                } else {
                    objTelao.sincronizar(false);
                    objTelao.setLoteIdAtual(acao);
                    objTelao.pingGeral();
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        sincronizar: function(acao) {
            try {
                var objTelao = this;
                if (acao) {
                    objTelao.setPingSincronizado(true);
                    clearTimeout(objTelao.ping.timeout);
                    objTelao.pingGeral();
                } else {
                    objTelao.setPingSincronizado(false);
                }

                objTelao.sincronizarView(acao);
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        sincronizarView: function(acao) {
            try {
                var objTelao = this;

                if (acao) {
                    $('#sincronizar').addClass('ativo');
                    // $('#sincronizar').find('.text').html('Sim');
                    // $('.ui-widget-content').addClass('ativo');

                    $('.panel-botoes-lance .panel-body').append('<div class="box-bloqueio-lance-sincronizado"><div class="inner"><div class="aviso">Clique aqui para dar o seu lance</div></div></div>');
                    $('.panel-lance-automatico .panel-body').append('<div class="box-bloqueio-lance-sincronizado"><div class="inner"><div class="aviso">Clique aqui para dar o seu lance</div></div></div>');

                    $('.box-bloqueio-lance-sincronizado .aviso').off('click').on('click', function(e) {
                        e.preventDefault();
                        objTelao.sincronizar(false);
                    });
                } else {
                    if ($('#sincronizar').hasClass('ativo')) {
                        $('#sincronizar').removeClass('ativo');
                        // $('#sincronizar').find('.text').html('N&atilde;o');
                        // $('.ui-widget-content').removeClass('ativo');

                        $('.panel-botoes-lance .panel-body').find('.box-bloqueio-lance-sincronizado').fadeOut(500, function() {
                            $(this).remove();
                        });
                        $('.panel-lance-automatico .panel-body').find('.box-bloqueio-lance-sincronizado').fadeOut(500, function() {
                            $(this).remove();
                        });

                        // objTelao.abrirNotificacao({
                        //     mensagem: 'Este leil&atilde;o n&atilde;o est&aacute; ao vivo',
                        //     tipo: 'warning'
                        // });
                    }
                }

                // $('#sincronizar').slider('value', (acao) ? 1 : 0);
            } catch(err) {
                this.erroTecnico(err)
            }
        },

        /*
        PROCESSOS

        1-) recebo o USER_ID, LEILAO_ID e LOTE_ID
        2-) executa o primeiro AJAX para buscar as config (atualmente so se esta ao vivo ou nao)
        3-) verifica qual lote vamos buscar (se o atual ou o ao vivo) e executa o ping
        4-) executo o ping
        5-) recebo o XML do ping
        6-) chamo os metodos de carregamento
        7-) chamo os metodos de exibicao
        8-) volta para o passo (4)
        */

        // metodos de processo
        iniciar: function() {
            var objTelao = this;

            // recebo o USER_ID, LEILAO_ID e LOTE_ID
            objTelao.setUserId($('#user_id').val());
            objTelao.setLeilaoId($('#leilao_id').val());
            objTelao.setLoteIdAtual($('#lote_id').val());
            objTelao.verificaMoeda();

            objTelao.pingConfig();
        },
        pingConfig: function() {
            try {
                var objTelao = this;

                var url_ajax = objTelao.montaPingUrl();
                var foco = 1;

                $.ajax({
                    url: url_ajax,
                    data: {foco: foco},
                    type: 'post',
                    success: function(retorno) {
                        objTelao.setPingRetorno(retorno);

                        let erro = objTelao.getPingRetorno().find('erro').attr('erro');
                        if (erro == 1) {
                            let mensagem = objTelao.getPingRetorno().find('erro').attr('mensagem')
                            objTelao.abrirMensagem({
                                titulo: 'Erro',
                                botaoFechar: false,
                                mensagem: mensagem,
                            })
                            return false
                        }

                        var lote_id_aovivo = objTelao.getPingRetorno().find('sslo_status lote').attr('lote_id_aovivo');
                        var lote_id_primeiro = objTelao.getPingRetorno().find('lote_list item').eq(0).attr('lote_id');

                        objTelao.setLoteIdAoVivo(lote_id_aovivo);
                        objTelao.setLoteIdPrimeiro(lote_id_primeiro);

                        // se nao foi selecionado um lote...
                        if (objTelao.getLoteIdAtual() == null) {
                            // se tem um lote ao vivo...
                            if (objTelao.getLoteIdAoVivo() != null) {
                                // iniciamos sincronizado
                                objTelao.sincronizar(true);

                                // setamos o lote atual com o lote ao vivo
                                objTelao.setLoteIdAtual(lote_id_aovivo);
                            } else {
                                // iniciamos como nao sincronizado
                                objTelao.sincronizar(false);

                                // setamos o lote atual como o primeiro lote
                                objTelao.setLoteIdAtual(lote_id_primeiro);
                            }
                        } else {
                            // iniciamos como nao sincronizado
                            objTelao.sincronizar(false);
                        }

                        objTelao.pingGeral();
                    },
                });
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        pingGeral: function() {
            try {
                var objTelao = this;
                var encerrado = objTelao.getEncerrado();

                if (encerrado == 1) {
                    objTelao.exibirEncerramentoLeilao();
                } else {
                    // se estiver sincronizado...
                    if (objTelao.getPingSincronizado() && objTelao.getLoteIdAoVivo() != null) {
                        // seto o lote do ping como o lote ao vivo
                        objTelao.setLoteIdProximo(objTelao.getLoteIdAoVivo());
                    } else {
                        // seto o lote do ping como o lote atual
                        objTelao.setLoteIdProximo(objTelao.getLoteIdAtual());
                    }

                    if (objTelao.getLoteIdProximo() != null) {
                        clearTimeout(objTelao.ping.timeout);
                        objTelao.setLoteIdAtual(objTelao.getLoteIdProximo());

                        var url_ajax = objTelao.montaPingUrl(objTelao.getLoteIdAtual());
                        var foco = 1;

                        // objTelao.mudarUrl();

                        $.ajax({
                            url: url_ajax,
                            data: {foco: foco},
                            type: 'post',
                            success: function(retorno) {
                                objTelao.pingXml(retorno);
                            },
                        });
                    }
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        pingXml: function(retorno) {
            try {
                var objTelao = this;

                if (typeof retorno != 'undefined') {
                    objTelao.setPingRetorno(retorno);
                }

                var erroLogin  = objTelao.getPingRetorno().find('erro').attr('erro');

                if (erroLogin == 1) {
                    var mensagem  = objTelao.getPingRetorno().find('erro').attr('mensagem');
                    objTelao.fechamentoTelao(mensagem);
                }else{
                    // medidas da tela
                    objTelao.carregarMedidasTela();

                    // navegador
                    objTelao.carregarNavegador();

                    // aviso
                    objTelao.avisoPing();

                    // carregamentos
                    objTelao.carregarDadosLeilao();
                    objTelao.carregarDadosLote();

                    // exibicao
                    objTelao.exibirDadosLeilao();
                    objTelao.exibirDadosLote();

                    // -----------------------------------------

                    // no final informo que este lote ja eh o anterior
                    objTelao.setLoteIdAnterior(objTelao.getLoteIdAtual());

                    // e pego novamente o lote_id_aovivo
                    var lote_id_aovivo = objTelao.getPingRetorno().find('sslo_status lote').attr('lote_id_aovivo');
                    objTelao.setLoteIdAoVivo(lote_id_aovivo);

                    objTelao.acoes();

                    // e chamo o ping
                    var tempo_ping = objTelao.getPingTempo();
                    if (false === objTelao.getPingSincronizado()) {
                        var refreshPhp = parseInt(objTelao.getPingRetorno().find('refresh').attr('time'));
                        tempo_ping = refreshPhp;
                    }
                    objTelao.ping.timeout = setTimeout(function() {
                        objTelao.pingGeral();
                    }, tempo_ping);
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        sairJanela: function() {
            try {
                var objTelao = this;
                objTelao.setPingTempo(objTelao.getPingTempoBlur());
                objTelao.setNavegadorFoco(false);
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        entrarJanela: function() {
            try {
                var objTelao = this;
                objTelao.setPingTempo(objTelao.getPingTempoFocus());
                objTelao.setNavegadorFoco(true);
                objTelao.pingGeral();
            } catch(err) {
                this.erroTecnico(err)
            }
        },

        // mensagens modais
        erroTecnico: function(err, metodo) {
            objTelao = this;
            // objTelao.debug('*** Telao.erroTecnico() ***');
            console.dir('*** Telao.erroTecnico() ***');

            if (typeof metodo == 'undefined') {
                metodo = false;
            }

            if (!metodo) {
                console.dir('Erro: ' + err.message);
            } else {
                console.dir('Erro: ' + err.message + ' [' + metodo + ']');
            }

            objTelao.abrirMensagem({
                titulo: 'Erro interno',
                mensagem: 'Desculpe, mas um erro inesperado aconteceu. Por favor, atualize a p&aacute;gina.',
                botaoFechar: true
            });
        },
        abrirMensagem: function(args, forcar_abrir_mensagem) {
            try {
                var objTelao = this;

                if (typeof forcar_abrir_mensagem == 'undefined') {
                    forcar_abrir_mensagem = false;
                }

                if (!objTelao.getMensagemAberta() || forcar_abrir_mensagem) {
                    var config = {
                        titulo: false,
                        mensagem: false,
                        botaoFechar: true,
                        largura: 600,
                        altura: 180,
                        centralizar: false,
                        botoes: [],
                    };

                    if (typeof args.titulo == 'string') { config.titulo = args.titulo; }
                    if (typeof args.mensagem == 'string') { config.mensagem = args.mensagem; }
                    if (typeof args.botaoFechar == 'boolean') { config.botaoFechar = args.botaoFechar; }
                    if (typeof args.largura == 'number') { config.largura = args.largura; }
                    if (typeof args.altura == 'number') { config.altura = args.altura; }
                    if (typeof args.centralizar == 'boolean') { config.centralizar = args.centralizar; }

                    if (typeof args.botoes == 'object') {
                        for (var i in args.botoes) {
                            var item = args.botoes[i];

                            if (typeof item.rotulo == 'string') {
                                var botao = {
                                    rotulo: item.rotulo,
                                    acao: function() {},
                                    fechar: false,
                                    classe: 'default'
                                };

                                if (typeof item.acao == 'function') { botao.acao = item.acao; }
                                if (typeof item.fechar == 'boolean') { botao.fechar = item.fechar; }
                                if (typeof item.classe == 'string') { botao.classe = item.classe; }

                                config.botoes.push(botao);
                            }
                        }
                    }

                    if (typeof config.mensagem == 'string') {
                        $boxMensagem = $('#boxMensagem');

                        // if (objTelao.getMensagemAberta()) {
                        //     $boxMensagem.off('hidden.bs.modal').on('hidden.bs.modal', function() {
                        //         objTelao.setMensagemAberta(false);
                        //         objTelao.abrirMensagem(args);
                        //     });
                        //     $boxMensagem.modal('hide');
                        // }

                        // mensagem
                        $boxMensagem.find('.modal-body').html(config.mensagem);

                        // titulo
                        if (typeof config.titulo == 'string' && $.trim(config.titulo) != '') {
                            $boxMensagem.find('.modal-header').show().find('.modal-title').html(config.titulo);
                        } else {
                            $boxMensagem.find('.modal-header').hide();
                        }

                        // botao fechar
                        if (config.botaoFechar) {
                            $boxMensagem.find('.modal-header button').show();
                        } else {
                            $boxMensagem.find('.modal-header button').hide();
                        }

                        // botoes
                        var botoes = config.botoes;
                        if (botoes.length > 0) {
                            $boxMensagem.find('.modal-footer').show();
                            $boxMensagem.find('.modal-footer').html('');
                            for (var i in botoes) {
                                var botao = botoes[i];

                                $boxMensagem.find('.modal-footer').append('<button type="button" class="btn btn-' + botao.classe + '" id="boxMensagem_btn_' + i + '" ' + (botao.fechar ? 'data-dismiss="modal"' : '') + '>' + botao.rotulo + '</button>');
                                $('#boxMensagem_btn_' + i).off('click').on('click', botao.acao);
                            }
                        } else {
                            $boxMensagem.find('.modal-footer').hide();
                        }
                        $boxMensagem.find('.modal-footer button').eq(0).focus();

                        if (!config.botaoFechar) {
                            $boxMensagem.modal({
                                backdrop: false,
                                keyboard: false
                            });
                        } else {
                            $boxMensagem.modal({
                                backdrop: false,
                                keyboard: false
                            });
                        }

                        $boxMensagem.off('show.bs.modal').on('show.bs.modal', function() {
                            objTelao.setMensagemAberta(true);
                        });
                        $boxMensagem.off('shown.bs.modal').on('shown.bs.modal', function() {
                            $boxMensagem.find('.modal-footer button').eq(0).focus();
                        });
                        $boxMensagem.off('hidden.bs.modal').on('hidden.bs.modal', function() {
                            objTelao.setMensagemAberta(false);
                        });
                    }
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        abrirNotificacao: function(args) {
            try {
                var objTelao = this;

                var config = {
                    icone: false,
                    mensagem: null,
                    tipo: 'info',
                };

                if (typeof args.icone == 'string') { config.icone = args.icone; }
                if (typeof args.mensagem == 'string') { config.mensagem = args.mensagem; }
                if (typeof args.tipo == 'string') { config.tipo = args.tipo; }

                if (config.mensagem != null) {
                    var notify_content = {
                        message: config.mensagem
                    };

                    if (!args.icone) {
                        notify_content.icon = config.icone;
                    }

                    $.notify(notify_content, {
                        type: config.tipo,
                        placement: {
                            from: "top",
                            align: "center"
                        },
                        delay: 1000,
                        timer: 1000,
                        animate: {
                            enter: 'animated flipInX',
                            exit: 'animated flipOutX'
                        },
                    });
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        avisoPing: function() {
            try {
                var objTelao = this;
                $aviso = objTelao.getPingRetorno().find('alert').find('aviso');
                var mensagem = $.trim($aviso.attr('mensagem'));
                var status_mensagem = $.trim($aviso.attr('status_mensagem'));

                if (mensagem != '') {
                    if (status_mensagem == 1) {
                        $('#boxMensagem').modal('hide');

                        objTelao.abrirNotificacao({
                            mensagem: mensagem,
                            tipo: 'success'
                        });
                    } else {
                        var altura = 180 + (Math.floor(mensagem.length / 60) * 20);

                        objTelao.abrirMensagem({
                            titulo: 'Mensagem do Lance',
                            mensagem: utf8_decode($aviso.attr('mensagem')),
                            centralizar: true,
                            altura: altura,
                            botoes: [
                                {
                                    rotulo: 'Fechar',
                                    classe: 'default',
                                    fechar: true
                                }
                            ]
                        }, true);
                    }
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        mensagemErro: function(mensagem, forcar_abrir_mensagem) {
            try {
                var objTelao = this;

                if (typeof forcar_abrir_mensagem == 'undefined') {
                    forcar_abrir_mensagem = false;
                }

                objTelao.abrirMensagem({
                    titulo: 'Erro no Lance',
                    botaoFechar: true,
                    mensagem: '<span style="color: #a00;">' + mensagem + '</span>',
                    centralizar: true,
                    botoes: [
                        {
                            rotulo: 'Fechar',
                            classe: 'default',
                            fechar: true
                        }
                    ]
                }, forcar_abrir_mensagem);
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        mensagemLance: function(vl_sugerido_real) {
            try {
                var objTelao = this;

                var simbolo_moeda = objTelao.getSimboloMoeda();
                var nome_lote = objTelao.lote_atual.nome;

                if (!objTelao.getCondicoesVendaAberta() && !objTelao.getCondicoesVendaAceita()) {
                    vl_sugerido_original = vl_sugerido_real;
                    objTelao.abrirCondicoes(function() {
                        objTelao.mensagemLance(vl_sugerido_original);
                    });
                    return;
                }

                var vl_sugerido_real = parseFloat(vl_sugerido_real);

                if (typeof vl_sugerido_real != 'number') {
                    objTelao.mensagemErro('Voc&ecirc; precisa selecionar um valor', true);
                } else if (vl_sugerido_real <= 0 || isNaN(vl_sugerido_real)) {
                    objTelao.mensagemErro('O lance precisa ser maior que zero', true);
                } else {
                    objTelao.abrirMensagem({
                        titulo: 'Lance Unit&aacute;rio',
                        botaoFechar: true,
                        mensagem: 'Deseja realmente enviar um lance unit&aacute;rio no valor de <b style="color: #a00;">' + simbolo_moeda + ' ' + number_format(vl_sugerido_real, 2, ',', '.') + '</b> no lote <b style="color: #a00;">' + objTelao.getLoteAtualNumero() + ' (' + nome_lote + ')</b> do leil&atilde;o <b style="color: #a00;">' + objTelao.getLeilaoId() + '</b>?',
                        largura: 680,
                        altura: 200,
                        botoes: [
                            {
                                rotulo: 'Enviar lance de <b>' + simbolo_moeda + ' ' + number_format(vl_sugerido_real, 2, ',', '.') + '</b>',
                                classe: 'success',
                                acao: function(e) {
                                    e.preventDefault();
                                    $.ajax({
                                        url: '/telao/leilao_id/' + objTelao.getLeilaoId() + '/lote_id/' + objTelao.getLoteIdAtual() + '/action/novolance/vl_lance/' + vl_sugerido_real,
                                        type: 'get',
                                        success: function(retorno) {
                                            try {
                                                fbq('trackCustom', 'ClickLance', {
                                                    value: 0,
                                                    currency: 'BRL'
                                                });

                                                gtag('event', 'conversion', {
                                                    'send_to': 'AW-1024217014/t8KUCOvKhvMBELafsegD',
                                                    'value': 0,
                                                    'currency': 'BRL'
                                                });
                                                
                                                insiderEventDispatch(objTelao, vl_sugerido_real, false);                                                                                              
                                            } catch (error) {
                                                console.error('erro ao enviar evento!');
                                                console.error(error);
                                            }

                                            objTelao.pingXml(retorno);
                                        }
                                    });
                                }
                            },
                            {
                                rotulo: 'Cancelar',
                                classe: 'default',
                                fechar: true
                            }
                        ]
                    }, true);
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        mensagemLanceAutomatico: function(vl_sugerido_real) {
            try {
                var objTelao = this;

                var simbolo_moeda = objTelao.getSimboloMoeda();
                var nome_lote = objTelao.lote_atual.nome;

                if (!objTelao.getCondicoesVendaAberta() && !objTelao.getCondicoesVendaAceita()) {
                    vl_sugerido_original = vl_sugerido_real;
                    objTelao.abrirCondicoes(function() {
                        objTelao.mensagemLanceAutomatico(vl_sugerido_original);
                    });
                    return;
                }

                var vl_sugerido_real = parseFloat(vl_sugerido_real);

                if (typeof vl_sugerido_real != 'number') {
                    objTelao.mensagemErro('Voc&ecirc; precisa selecionar um valor', true);
                } else if (vl_sugerido_real <= 0 || isNaN(vl_sugerido_real)) {
                    objTelao.mensagemErro('O lance precisa ser maior que zero', true);
                } else {
                    var mensagem = 'Deseja realmente enviar um lance autom&aacute;tico no valor de <b style="color: #a00;">' + simbolo_moeda + ' ' + number_format(vl_sugerido_real, 2, ',', '.') + '</b> no lote <b style="color: #a00;">' + objTelao.getLoteAtualNumero() + ' (' + nome_lote + ')</b> do leil&atilde;o <b style="color: #a00;">' + objTelao.getLeilaoId() + '</b>?';
                    mensagem += '<br><br>';
                    mensagem += 'Deseja tamb&eacute;m que o seu lance tenha um b&ocirc;nus de um incremento caso haja um empate?';
                    mensagem += '<br>';
                    mensagem += '&nbsp;&nbsp;&nbsp;&nbsp;<label style="color: #0a0;"><input type="radio" name="radioBonusLanceAutomatico" value="1"> Sim, quero que meu lance tenha o b&ocirc;nus</label><br>';
                    mensagem += '&nbsp;&nbsp;&nbsp;&nbsp;<label style="color: #a00;"><input type="radio" name="radioBonusLanceAutomatico" value="0"> N&atilde;o, quero que meu lance n&atilde;o tenha o b&ocirc;nus</label>';
                    objTelao.abrirMensagem({
                        titulo: 'Lance Autom&aacute;tico',
                        botaoFechar: true,
                        mensagem: mensagem,
                        largura: 680,
                        altura: 350,
                        botoes: [
                            {
                                rotulo: 'Enviar lance de <b>' + simbolo_moeda + ' ' + number_format(vl_sugerido_real, 2, ',', '.') + '</b>',
                                classe: 'success',
                                acao: function(e) {
                                    e.preventDefault();

                                    var radioBonusLanceAutomatico = $('[name=radioBonusLanceAutomatico]:checked').val();

                                    if (typeof radioBonusLanceAutomatico == 'undefined') {
                                        alert('Informe se deseja o bonus');
                                    } else {
                                        $.ajax({
                                            url: '/telao/leilao_id/' + objTelao.getLeilaoId() + '/lote_id/' + objTelao.getLoteIdAtual() + '/action/automatico/vl_automatico/' + vl_sugerido_real + '/vl_bonus/' + radioBonusLanceAutomatico + '/',
                                            // lance unitario - url: '/telao/leilao_id/' + objTelao.leilao_id + '/lote_id/' + objTelao.lote_id + '/action/novolance/vl_lance/' + vl_sugerido_real,
                                            // com bonus - https://sodresantoro.leandro/telao/leilao_id/12709/lote_id/1530478/action/automatico/vl_automatico/1200/vl_bonus/200/
                                            // exclusao - https://sodresantoro.leandro/telao/leilao_id/12709/lote_id/1530478/action/rm_automatico/lanceauto_id/416/user_id_rm_lanceauto/171274
                                            type: 'get',
                                            success: function(retorno) {
                                                try {
                                                    insiderEventDispatch(objTelao, vl_sugerido_real, true);
                                                } catch (error) {
                                                    console.log('evento não enviado.');
                                                    console.log(error);
                                                }
                                                objTelao.pingXml(retorno);
                                            }
                                        });
                                    }
                                }
                            },
                            {
                                rotulo: 'Cancelar',
                                classe: 'default',
                                fechar: true
                            }
                        ]
                    }, true);
                }
            } catch(err) {
                this.erroTecnico(err)
            }
        },
        mensagemExcluirLanceAutomatico: function() {
            try {
                var objTelao = this;

                var simbolo_moeda = objTelao.getSimboloMoeda();

                objTelao.abrirMensagem({

        exibirOutrosLances: function() {
            try {
                var objTelao = this;

                if (!objTelao.getCondicoesVendaAberta() && !objTelao.getCondicoesVendaAceita()) {
                    objTelao.abrirCondicoes(function() {
                        objTelao.exibirOutrosLances();
                    });
                    return;
                }

                var vl_sugerido_real = parseFloat($('.act-lista-botoes-lance').find('.ultimo-botao-lance').attr('data-vl-sugerido-real'));
                var ultimo_lance = parseFloat(vl_sugerido_real);
                var incremento = parseFloat(objTelao.getLoteAtualIncremento())
                var limite = 30;

                var html_modal = '<p>Selecione o valor do lance:</p>';
                html_modal += '<select class="form-control act-outros-lances">';
                html_modal += '<option value="">-- Selecione --</option>';
                for (var i = 1; i < limite; i++) {
                    var valor_outro_lance = ultimo_lance + incremento;
                    ultimo_lance = valor_outro_lance;
                    html_modal += '<option value="' + valor_outro_lance + '">' + number_format(valor_outro_lance, 2, ',', '.') + objTelao.exibeMsgPorQuilo() + '</option>';
                }
                html_modal += '</select>';

                objTelao.abrirMensagem({
                    titulo: 'Enviar Lance Unit&aacute;rio',
                    botaoFechar: true,
                    mensagem: html_modal,
                    largura: 680,
                    altura: 200,
                    botoes: [
                        {
                            rotulo: 'Selecionar lance unit&aacute;rio',
                            classe: 'success',
                            acao: function(e) {
                                e.preventDefault();

                                var $btn = $(this);
                                var vl_sugerido_real = parseFloat($('.act-outros-lances').val());
                                objTelao.mensagemLance(vl_sugerido_real);
                            }
                        },
                        {
                            rotulo: 'Cancelar',
                            classe: 'default',
                            fechar: true
                        }
                    ]
                });
            } catch(err) {
                this.erroTecnico(err)
            }
        },

                let infoList = '<ul class="list-unstyled">';
                nm_info_taxa.forEach(v => {
                    if (this.leilao.nome.indexOf("(TJ)") > -1 && v.indexOf("Sedex") > -1) {
                         return   
                    } 

                    infoList += '<li>' +  v  + '</li>';                    
                })
                infoList += '</ul>';
                return infoList;
            }
            return this.lote_atual.nm_info_taxa;
        },

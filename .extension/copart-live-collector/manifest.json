{
  "manifest_version": 3,
  "name": "Picareta Smart Assistant",
  "description": "Assistente inteligente para análise e coleta de veículos em leilões ao vivo.",
  "version": "0.17.5",
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Picareta Smart Assistant"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "host_permissions": [
    "https://picareta-bot.felss.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "https://*.copart.com/*",
        "http://*.copart.com/*",
        "https://*.copart.com.br/*",
        "http://*.copart.com.br/*",
        "https://*.vipleiloes.com.br/*",
        "http://*.vipleiloes.com.br/*",
        "https://*.sodresantoro.com.br/*",
        "http://*.sodresantoro.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://felssner.com.br/*",
        "https://www.felssner.com.br/*",
        "https://picareta.felss.dev/*",
        "https://www.picareta.felss.dev/*",
        "https://picareta-bot.felss.dev/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "connection-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}

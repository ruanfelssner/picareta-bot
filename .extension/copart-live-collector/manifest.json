{
  "manifest_version": 3,
  "name": "Copart Preview Only",
  "description": "Mostra um preview JSON simples dos exemplos locais da Copart.",
  "version": "0.2.0",
  "action": {
    "default_title": "Copart Preview Only"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "https://*.copart.com/*",
        "http://*.copart.com/*",
        "https://*.copart.com.br/*",
        "http://*.copart.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}

{
  "manifest_version": 3,
  "name": "Picareta Smart Assistant",
  "description": "Assistente inteligente para análise e coleta de veículos em leilões ao vivo.",
  "version": "0.7.6",
  "action": {
    "default_title": "Picareta Smart Assistant"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "https://*.copart.com/*",
        "http://*.copart.com/*",
        "https://*.copart.com.br/*",
        "http://*.copart.com.br/*",
        "https://*.vipleiloes.com.br/*",
        "http://*.vipleiloes.com.br/*",
        "https://*.sodresantoro.com.br/*",
        "http://*.sodresantoro.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}

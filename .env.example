SEARCH_TERM=""
MAX_SCROLLS=4
HEADLESS=false
PROFILE_PATH="./data/facebook-profile"
OUTPUT_PATH="./output/results.json"
DEV_PORT=4000 # use 0 para porta automática
DEV_HOST="127.0.0.1" # use "0.0.0.0" para expor na rede local
MONGO_URI=""
MONGO_DB_NAME="marketplace"
MONGO_QUEUE_URI=""
MONGO_QUEUE_DB_NAME=""
MONGO_DATA_URI=""
MONGO_DATA_DB_NAME=""

# Picareta â€” avisa uma vez ao final do scraping quando houver veiculos novos
PICARETA_OPPORTUNITY_WEBHOOK_URL="https://picareta.felss.dev/api/v1/push/opportunity-matches"
PICARETA_INGEST_KEY="" # mesmo valor de NUXT_SCRAPED_VEHICLES_INGEST_KEY no Picareta

ZAPI_ENABLED=false
ZAPI_BASE_URL="https://api.z-api.io"
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
ZAPI_CLIENT_TOKEN=""
ZAPI_PHONE="" # contato (55119...) ou grupo (1203...-group)
ZAPI_MAX_IMAGES=5
ZAPI_DELAY_MESSAGE=2
ZAPI_VIEW_ONCE=false
WORKER_POLL_SECONDS=8
WORKER_HEARTBEAT_SECONDS=20
WORKER_ID=""

# Leilão — cron diário e grupo de destino
AUCTION_CRON_SCHEDULE="0 7 * * *"  # padrão: 07:00 horário de Brasília
AUCTION_GROUP_PHONE=""              # deixe vazio para usar ZAPI_PHONE
CLAUDIO_KUSS_LEILAO_IDS=""         # opcional (ex.: "872,873"), vazio = descoberta automática
CLAUDIO_KUSS_MAX_AUCTIONS=4        # limite de leilões descobertos por execução
CLAUDIO_KUSS_MAX_PAGES=40          # limite de páginas por leilão
SCRAPER_SOURCE_TIMEOUT_MS=300000   # timeout por fonte no scraping manual/API
VIPLEILOES_MAX_PAGES=40            # limite de páginas por classificação da VIP
VIPLEILOES_CLASSIFICATIONS="Usados,Seminovos,Sinistrados" # ordem da VIP; deixe só "Usados" para priorizar essa coleta
VIPLEILOES_REQUEST_DELAY_MS=1500   # intervalo entre páginas/requisições da VIP
VIPLEILOES_PROFILE_PATH="./data/vipleiloes-profile" # perfil persistente Playwright da VIP
VIPLEILOES_HEADLESS=""             # opcional; false abre navegador para validação manual da VIP

# FIPE API (Deivid Fortuna)
FIPE_API_ENABLED=true
FIPE_API_BASE_URL="https://fipe.parallelum.com.br/api/v2"
FIPE_API_VEHICLE_TYPE="cars"
FIPE_API_TOKEN=""                  # opcional: token gratuito em https://fipe.online para aumentar limite diário
FIPE_API_REFERENCE=""              # opcional: código de referência (ex.: 308)
FIPE_API_TIMEOUT_MS=15000

# Compatibilidade (opcional) com variáveis antigas:
